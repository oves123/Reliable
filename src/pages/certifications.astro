---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Certifications & Quality Standards | Reliable Industries" description="Explore Reliable Industries' international accreditations, including API Spec Q1, ASME U Stamp, ISO 9001:2015, ATEX, FDA, and RoHS compliance certificates.">
  <Header />

  <!-- Hero Header -->
  <section class="cert-page-hero" style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 85px 0 100px; color: white; text-align: center;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">GLOBAL STANDARDS & ACCREDITATIONS</span>
      <h1 style="font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 800; margin-bottom: 20px;">Quality & Compliance Certifications</h1>
      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 800px; margin: 0 auto; line-height: 1.6;">
        Every mechanical seal and auxiliary system manufactured by Reliable Industries adheres to the world's most rigorous engineering and safety standards.
      </p>
    </div>
  </section>

  <!-- Certificates Grid -->
  <section style="padding: 80px 0; background: #ffffff;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 35px;">
        
        <!-- Cert 1 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #fef3c7; color: #b45309; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">PETROLEUM & GAS</span>
              <i class="fas fa-certificate" style="font-size: 2rem; color: #b45309;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">API Spec Q1 / ISO 29001</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              Quality management system specifications for manufacturing organizations in the petroleum and natural gas industries (API 682 4th Edition compliant).
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: Active & Audited</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

        <!-- Cert 2 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #fee2e2; color: #b91c1c; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">PRESSURE VESSELS</span>
              <i class="fas fa-stamp" style="font-size: 2rem; color: #b91c1c;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">ASME "U" Stamp (115366 BPV)</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              American Society of Mechanical Engineers authorization for manufacturing unfired pressure vessels, barrier fluid reservoirs, and heat exchanger systems.
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: Certified & Registered</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

        <!-- Cert 3 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">QUALITY MANAGEMENT</span>
              <i class="fas fa-award" style="font-size: 2rem; color: #0369a1;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">ISO 9001:2015</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              International standard for Quality Management Systems covering precision design, raw material traceability, CNC production, and final QA hydro-testing.
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: Certified QA System</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

        <!-- Cert 4 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #fef9c3; color: #854d0e; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">EXPLOSION PROOF</span>
              <i class="fas fa-bolt" style="font-size: 2rem; color: #854d0e;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">ATEX Directive 2014/34/EU</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              Certification of mechanical seals and components for safe, non-sparking operation in explosive gas, vapor, and combustible dust environments (Zone 1 & 2).
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: CE / Ex Marked</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

        <!-- Cert 5 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #d1fae5; color: #047857; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">EHS COMPLIANCE</span>
              <i class="fas fa-leaf" style="font-size: 2rem; color: #047857;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">ISO 14001 & ISO 45001</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              Integrated Environmental Management and Occupational Health & Safety Systems ensuring eco-friendly operations, zero hazardous emissions, and workplace safety.
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: Fully Compliant</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

        <!-- Cert 6 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 30px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column; justify-content: space-between;">
          <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
              <span style="background: #f3e8ff; color: #7e22ce; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 800;">SANITARY & PHARMA</span>
              <i class="fas fa-flask" style="font-size: 2rem; color: #7e22ce;"></i>
            </div>
            <h3 style="font-size: 1.3rem; font-weight: 800; color: #002b54; margin-bottom: 8px;">FDA & EU 1935/2004 Sanitary</h3>
            <p style="font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 16px;">
              Compliance certificates for seal elastomers and face materials contacting food, beverages, and active pharmaceutical ingredients (USP Class VI certified).
            </p>
          </div>
          <div style="border-top: 1px solid #f1f5f9; padding-top: 15px; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.8rem; font-weight: 600; color: #0284c7;">Status: Approved Materials</span>
            <a href="/brochures/product_brochure.pdf" download class="btn-sm" style="font-size: 0.8rem; font-weight: 700; color: #009fe3; text-decoration: none;">Download PDF &rarr;</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
