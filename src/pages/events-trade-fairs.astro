---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Events & Trade Fairs | Reliable Industries Worldwide" description="Meet Reliable Industries at leading international engineering exhibitions, trade fairs, and oil & gas conferences around the globe.">
  <Header />

  <!-- Hero Header -->
  <section style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 85px 0 100px; color: white; text-align: center;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">GLOBAL EXHIBITIONS & CONFERENCES</span>
      <h1 style="font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 800; margin-bottom: 20px;">Events & Trade Fairs</h1>
      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 780px; margin: 0 auto; line-height: 1.6;">
        Connect directly with our engineering directors and explore live product demonstrations at international trade exhibitions.
      </p>
    </div>
  </section>

  <!-- Events List -->
  <section style="padding: 80px 0; background: #ffffff;">
    <div class="container">
      <div style="display: flex; flex-direction: column; gap: 30px; max-width: 950px; margin: 0 auto;">
        
        <!-- Event 1 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 32px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: grid; grid-template-columns: 160px 1fr auto; gap: 30px; align-items: center;">
          <div style="background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #0284c7;">NOV</div>
            <div style="font-size: 1.2rem; font-weight: 700; color: #002b54;">10 - 13</div>
            <div style="font-size: 0.8rem; color: #64748b; font-weight: 600;">2026</div>
          </div>
          <div>
            <span style="color: #009fe3; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Oil, Gas & Energy</span>
            <h3 style="font-size: 1.35rem; font-weight: 800; color: #002b54; margin: 6px 0 8px 0;">ADIPEC Abu Dhabi International Exhibition</h3>
            <p style="color: #64748b; font-size: 0.92rem; line-height: 1.5; margin-bottom: 8px;">Abu Dhabi National Exhibition Centre (ADNEC), UAE • Stand Hall 8, Booth 8320</p>
            <p style="color: #475569; font-size: 0.9rem;">Showcasing API 682 4th Edition dual cartridge seals and thermosyphon auxiliary barrier systems.</p>
          </div>
          <div>
            <a href="/contact" class="btn btn-primary" style="background: #002b54; border: none; padding: 10px 22px; border-radius: 6px; font-weight: 600; font-size: 0.88rem; white-space: nowrap;">Book Meeting</a>
          </div>
        </div>

        <!-- Event 2 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 32px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: grid; grid-template-columns: 160px 1fr auto; gap: 30px; align-items: center;">
          <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #16a34a;">DEC</div>
            <div style="font-size: 1.2rem; font-weight: 700; color: #002b54;">03 - 06</div>
            <div style="font-size: 0.8rem; color: #64748b; font-weight: 600;">2026</div>
          </div>
          <div>
            <span style="color: #16a34a; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Chemical & Process Engineering</span>
            <h3 style="font-size: 1.35rem; font-weight: 800; color: #002b54; margin: 6px 0 8px 0;">CHEMTECH World Expo Mumbai</h3>
            <p style="color: #64748b; font-size: 0.92rem; line-height: 1.5; margin-bottom: 8px;">Bombay Exhibition Centre (NESCO), Mumbai, India • Hall 1, Stall B-14</p>
            <p style="color: #475569; font-size: 0.9rem;">Demonstrating sanitary agitator seals for pharma and heavy-duty slurry seals for chemical plants.</p>
          </div>
          <div>
            <a href="/contact" class="btn btn-primary" style="background: #002b54; border: none; padding: 10px 22px; border-radius: 6px; font-weight: 600; font-size: 0.88rem; white-space: nowrap;">Book Meeting</a>
          </div>
        </div>

        <!-- Event 3 -->
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 32px; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: grid; grid-template-columns: 160px 1fr auto; gap: 30px; align-items: center;">
          <div style="background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 8px; padding: 15px; text-align: center;">
            <div style="font-size: 1.8rem; font-weight: 800; color: #9333ea;">FEB</div>
            <div style="font-size: 1.2rem; font-weight: 700; color: #002b54;">18 - 22</div>
            <div style="font-size: 0.8rem; color: #64748b; font-weight: 600;">2027</div>
          </div>
          <div>
            <span style="color: #9333ea; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Global Industrial Automation</span>
            <h3 style="font-size: 1.35rem; font-weight: 800; color: #002b54; margin: 6px 0 8px 0;">Hannover Messe Industrial Expo</h3>
            <p style="color: #64748b; font-size: 0.92rem; line-height: 1.5; margin-bottom: 8px;">Hannover Exhibition Grounds, Germany • Hall 24, Stand C45</p>
            <p style="color: #475569; font-size: 0.9rem;">Presenting high-speed rotating unions for water, steam, and high-pressure hydraulic services.</p>
          </div>
          <div>
            <a href="/contact" class="btn btn-primary" style="background: #002b54; border: none; padding: 10px 22px; border-radius: 6px; font-weight: 600; font-size: 0.88rem; white-space: nowrap;">Book Meeting</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
