---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us | Reliable Industries - Pioneer in Sealing Technology" description="Learn about Reliable Industries - 30+ years of engineering excellence, manufacturing heavy-duty mechanical seals, cartridge systems, and sealing support units worldwide.">
  <Header />

  <!-- Hero Header -->
  <section class="about-hero" style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 90px 0 110px; color: white; text-align: center; position: relative;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">OUR STORY & LEGACY</span>
      <h1 style="font-size: clamp(2.4rem, 4vw, 3.5rem); font-weight: 800; margin-bottom: 20px; line-height: 1.15;">Pioneering Sealing Technology For Over Three Decades</h1>
      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 820px; margin: 0 auto; line-height: 1.6;">
        From precision engineering to mission-critical zero-leakage systems, Reliable Industries manufactures high-performance mechanical seals trusted by heavy process industries across 50+ countries.
      </p>
    </div>
  </section>

  <!-- Story & Vision Split -->
  <section style="padding: 80px 0; background: #ffffff;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 50px; align-items: center;">
        <div>
          <span style="color: #009fe3; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 10px;">WHO WE ARE</span>
          <h2 style="font-size: 2.2rem; font-weight: 800; color: #002b54; line-height: 1.25; margin-bottom: 20px;">Precision Engineered For Extreme Industrial Demands</h2>
          <p style="color: #475569; font-size: 1rem; line-height: 1.7; margin-bottom: 18px;">
            Founded with an uncompromising commitment to manufacturing integrity, <strong>Reliable Industries</strong> has grown into an internationally renowned designer and manufacturer of mechanical seals, standard cartridge systems, rotary joints, and auxiliary seal support systems.
          </p>
          <p style="color: #475569; font-size: 1rem; line-height: 1.7; margin-bottom: 25px;">
            Our state-of-the-art facility in Mumbai incorporates multi-axis CNC turning, automated grinding centers, and digital hydro-testing rigs complying with API 682, ISO 9001:2015, ATEX, and FDA standards.
          </p>
          <div style="display: flex; gap: 30px; border-top: 1px solid #edf2f7; padding-top: 25px;">
            <div>
              <div style="font-size: 2.2rem; font-weight: 800; color: #009fe3;">30+</div>
              <div style="font-size: 0.85rem; font-weight: 600; color: #64748b;">Years Industry Legacy</div>
            </div>
            <div>
              <div style="font-size: 2.2rem; font-weight: 800; color: #009fe3;">50+</div>
              <div style="font-size: 0.85rem; font-weight: 600; color: #64748b;">Countries Served</div>
            </div>
            <div>
              <div style="font-size: 2.2rem; font-weight: 800; color: #009fe3;">10,000+</div>
              <div style="font-size: 0.85rem; font-weight: 600; color: #64748b;">Global Installations</div>
            </div>
          </div>
        </div>

        <div style="position: relative;">
          <img src="/images/hero_industrial_new.jpg" alt="Reliable Industries CNC Plant" style="width: 100%; border-radius: 8px; box-shadow: 0 15px 35px rgba(0, 43, 73, 0.15); display: block;" />
        </div>
      </div>
    </div>
  </section>

  <!-- Core Values -->
  <section style="padding: 70px 0 90px; background: #f8fafc; border-top: 1px solid #e2e8f0;">
    <div class="container">
      <div style="text-align: center; max-width: 700px; margin: 0 auto 50px auto;">
        <span style="color: #009fe3; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 8px;">OUR GUIDING PILLARS</span>
        <h2 style="font-size: 2.2rem; font-weight: 800; color: #002b54;">Engineered For Absolute Reliability</h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
        <div style="background: white; padding: 35px 25px; border-radius: 8px; border: 1px solid #eef2f6; box-shadow: 0 6px 18px rgba(0,0,0,0.03);">
          <i class="fas fa-shield-alt" style="font-size: 2.2rem; color: #009fe3; margin-bottom: 18px;"></i>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #002b54; margin-bottom: 12px;">Uncompromising Quality</h3>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;">Every seal undergoes dimensional CMM verification and hydrostatic leak testing to guarantee zero-defect field installation.</p>
        </div>

        <div style="background: white; padding: 35px 25px; border-radius: 8px; border: 1px solid #eef2f6; box-shadow: 0 6px 18px rgba(0,0,0,0.03);">
          <i class="fas fa-microchip" style="font-size: 2.2rem; color: #009fe3; margin-bottom: 18px;"></i>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #002b54; margin-bottom: 12px;">Continuous Innovation</h3>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;">Our in-house R&D and FEA computational simulations engineer custom seal geometries that conquer corrosive and extreme thermal fluids.</p>
        </div>

        <div style="background: white; padding: 35px 25px; border-radius: 8px; border: 1px solid #eef2f6; box-shadow: 0 6px 18px rgba(0,0,0,0.03);">
          <i class="fas fa-globe" style="font-size: 2.2rem; color: #009fe3; margin-bottom: 18px;"></i>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #002b54; margin-bottom: 12px;">Global Client Commitment</h3>
          <p style="color: #64748b; font-size: 0.92rem; line-height: 1.6;">Rapid technical dispatch, direct engineering consulting, and dedicated plant turnaround support anywhere across the globe.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="background: linear-gradient(135deg, #002b54 0%, #001a35 100%); padding: 60px 0; color: white; text-align: center;">
    <div class="container">
      <h2 style="font-size: 2rem; font-weight: 800; margin-bottom: 15px;">Have A Complex Sealing Challenge?</h2>
      <p style="color: #cbd5e1; font-size: 1.05rem; max-width: 600px; margin: 0 auto 25px auto;">Speak directly with our senior application engineering team for customized solutions.</p>
      <a href="/contact" class="btn btn-primary" style="background: #009fe3; border: none; padding: 14px 35px; border-radius: 50px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Contact An Expert</a>
    </div>
  </section>

  <Footer />
</Layout>
