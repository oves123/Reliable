---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import groq from 'groq';

const siteSettings = await sanityClient.fetch(groq`*[_type == "siteSettings"][0]`);
const contactData = await sanityClient.fetch(groq`*[_type == "contactPage"][0]`);

const address = siteSettings?.address || "AF-02, 03, 04 Saraf Kaskar Ind. Prem Co-op. Soc. Ltd.,\nS.V.Road, Oshiwara, Jogeshwari (W),\nMumbai - 400102";
const email = siteSettings?.email || "info@reliableseal.com";
const phoneNumbers = siteSettings?.phoneNumbers || ["+91- 78880 65557", "+91- 78880 65558", "+91- 78880 65559"];

const heroSubtitle = contactData?.heroSubtitle || "Get in Touch";
const heroTitle = contactData?.heroTitle || "Contact Our Experts";
const heroDescription = contactData?.heroDescription || "Whether you need a custom quote, technical support, or have a general inquiry, our team of sealing experts is ready to assist you.";
const mainTitle = contactData?.mainTitle || "Let's build something <span class=\"highlight\">Reliable</span> together.";
const mainSubtitle = contactData?.mainSubtitle || "Reach out to our global headquarters or fill out the form, and a representative will get back to you within 24 hours.";
---

<Layout>
  <Header />
  
  <main class="contact-page">
    <!-- Hero Section -->
    <section class="contact-hero">
      <div class="container">
        <span class="kicker">{heroSubtitle}</span>
        <h1>{heroTitle}</h1>
        <p>{heroDescription}</p>
      </div>
    </section>

    <!-- Main Content -->
    <section class="contact-content">
      <div class="container">
        <div class="contact-grid">
          
          <!-- Contact Info -->
          <div class="contact-info-panel">
            <h2 set:html={mainTitle}></h2>
            <p class="subtitle">{mainSubtitle}</p>
            
            <div class="info-blocks">
              <div class="info-block">
                <div class="icon-circle">
                  <i class="fas fa-map-marker-alt"></i>
                </div>
                <div class="info-text">
                  <h3>Headquarters</h3>
                  <p set:html={address.replace(/\n/g, '<br>')}></p>
                </div>
              </div>
              
              <div class="info-block">
                <div class="icon-circle">
                  <i class="fas fa-envelope"></i>
                </div>
                <div class="info-text">
                  <h3>Email Us</h3>
                  <p><a href={`mailto:${email}`}>{email}</a></p>
                </div>
              </div>
              
              <div class="info-block">
                <div class="icon-circle">
                  <i class="fas fa-phone-alt"></i>
                </div>
                <div class="info-text">
                  <h3>Call Us</h3>
                  <p>
                      {phoneNumbers.map((phone: string, idx: number) => (
                          <Fragment key={idx}>
                              {phone}
                              {idx < phoneNumbers.length - 1 && <br />}
                          </Fragment>
                      ))}
                  </p>
                </div>
              </div>

              <div class="info-block">
                <div class="icon-circle">
                  <i class="fas fa-clock"></i>
                </div>
                <div class="info-text">
                  <h3>Business & Plant Hours</h3>
                  <p>Monday - Saturday: 9:00 AM - 7:00 PM IST<br><strong style="color: #009fe3;">24/7 Breakdown Emergency Line</strong></p>
                </div>
              </div>
            </div>

            <!-- Instant Contact Buttons -->
            <div style="display: flex; gap: 12px; margin-top: 25px; flex-wrap: wrap;">
              <a href="https://wa.me/917888065557?text=Hello%20Reliable%20Industries%2C%20I%20have%20an%20inquiry" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; background: #25D366; color: white; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);">
                <i class="fab fa-whatsapp" style="font-size: 1.2rem;"></i>
                <span>WhatsApp Instant</span>
              </a>
              <a href="tel:+917888065557" style="display: inline-flex; align-items: center; gap: 8px; background: #002b54; color: white; padding: 10px 20px; border-radius: 6px; font-weight: 700; font-size: 0.9rem; text-decoration: none; box-shadow: 0 4px 12px rgba(0, 43, 84, 0.25);">
                <i class="fas fa-phone-alt"></i>
                <span>Direct Hotline</span>
              </a>
            </div>
            
            <div class="social-connect" style="margin-top: 30px;">
              <h3>Connect With Us</h3>
              <div class="social-links">
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-youtube"></i></a>
              </div>
            </div>
          </div>
          
          <!-- Contact Form -->
          <div class="contact-form-panel">
            <div class="form-card">
              <h2>Send a Message</h2>
              <p>Fill out the form below and we will get back to you promptly.</p>
              
              <form action="#" method="POST" class="reliable-form">
                <div class="form-row">
                  <div class="form-group">
                    <label for="firstName">First Name *</label>
                    <input type="text" id="firstName" name="firstName" required placeholder="John">
                  </div>
                  <div class="form-group">
                    <label for="lastName">Last Name *</label>
                    <input type="text" id="lastName" name="lastName" required placeholder="Doe">
                  </div>
                </div>
                
                <div class="form-row">
                  <div class="form-group">
                    <label for="email">Business Email *</label>
                    <input type="email" id="email" name="email" required placeholder="john@company.com">
                  </div>
                  <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000">
                  </div>
                </div>
                
                <div class="form-group">
                  <label for="company">Company Name *</label>
                  <input type="text" id="company" name="company" required placeholder="Your Company Ltd.">
                </div>
                
                <div class="form-group">
                  <label for="inquiryType">Reason for Inquiry *</label>
                  <div class="select-wrapper">
                    <select id="inquiryType" name="inquiryType" required>
                      <option value="" disabled selected>Select an option...</option>
                      <option value="quote">Request a Quote</option>
                      <option value="technical">Technical Support</option>
                      <option value="partnership">Partnership / Distribution</option>
                      <option value="other">General Inquiry</option>
                    </select>
                    <i class="fas fa-chevron-down select-icon"></i>
                  </div>
                </div>
                
                <div class="form-group">
                  <label for="message">Message / Details *</label>
                  <textarea id="message" name="message" rows="5" required placeholder="Please describe your requirements, operating conditions, or the product you are interested in..."></textarea>
                </div>
                
                <button type="submit" class="btn btn-primary form-submit-btn">
                  Send Message <i class="fas fa-paper-plane" style="margin-left: 8px;"></i>
                </button>
                <p class="form-disclaimer">By submitting this form, you agree to our <a href="#">Privacy Policy</a> and consent to being contacted regarding your inquiry.</p>
              </form>
            </div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Specialized Departments Directory -->
    <section class="departments-section" style="padding: 60px 0; background: #ffffff; border-top: 1px solid #edf2f7;">
      <div class="container">
        <div style="text-align: center; max-width: 700px; margin: 0 auto 40px auto;">
          <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1px; display: block; margin-bottom: 8px;">Direct Support</span>
          <h2 style="font-size: 2rem; font-weight: 800; color: #002b54; margin: 0 0 10px 0;">Specialized Department Contacts</h2>
          <p style="color: #64748b; font-size: 0.95rem; line-height: 1.5;">Connect directly with the relevant division for instant assistance and prompt resolution.</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;">
          <!-- Dept 1 -->
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 25px; transition: all 0.3s;">
            <div style="width: 48px; height: 48px; border-radius: 8px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 16px;">
              <i class="fas fa-cogs"></i>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #002b54; margin-bottom: 8px;">Technical & Engineering</h3>
            <p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin-bottom: 14px;">Seal selection, CAD drawings, operating limits, and customized troubleshooting.</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54; margin-bottom: 4px;"><i class="fas fa-envelope" style="color: #009fe3; margin-right: 6px;"></i> tech@reliableseal.com</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54;"><i class="fas fa-phone-alt" style="color: #009fe3; margin-right: 6px;"></i> +91- 78880 65557</p>
          </div>

          <!-- Dept 2 -->
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 25px; transition: all 0.3s;">
            <div style="width: 48px; height: 48px; border-radius: 8px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 16px;">
              <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #002b54; margin-bottom: 8px;">Sales & Quotations</h3>
            <p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin-bottom: 14px;">Domestic and export RFQs, volume pricing, and commercial procurement inquiries.</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54; margin-bottom: 4px;"><i class="fas fa-envelope" style="color: #009fe3; margin-right: 6px;"></i> sales@reliableseal.com</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54;"><i class="fas fa-phone-alt" style="color: #009fe3; margin-right: 6px;"></i> +91- 78880 65558</p>
          </div>

          <!-- Dept 3 -->
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 25px; transition: all 0.3s;">
            <div style="width: 48px; height: 48px; border-radius: 8px; background: #d1fae5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 16px;">
              <i class="fas fa-shipping-fast"></i>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #002b54; margin-bottom: 8px;">Dispatch & Logistics</h3>
            <p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin-bottom: 14px;">Order tracking, air & sea freight logistics, and urgent shutdown shipments.</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54; margin-bottom: 4px;"><i class="fas fa-envelope" style="color: #009fe3; margin-right: 6px;"></i> dispatch@reliableseal.com</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54;"><i class="fas fa-phone-alt" style="color: #009fe3; margin-right: 6px;"></i> +91- 78880 65559</p>
          </div>

          <!-- Dept 4 -->
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 25px; transition: all 0.3s;">
            <div style="width: 48px; height: 48px; border-radius: 8px; background: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; margin-bottom: 16px;">
              <i class="fas fa-certificate"></i>
            </div>
            <h3 style="font-size: 1.15rem; font-weight: 700; color: #002b54; margin-bottom: 8px;">Quality & QA Inspection</h3>
            <p style="font-size: 0.88rem; color: #64748b; line-height: 1.5; margin-bottom: 14px;">Material test reports (MTR), API 682 hydro test certificates, and compliance audits.</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54; margin-bottom: 4px;"><i class="fas fa-envelope" style="color: #009fe3; margin-right: 6px;"></i> quality@reliableseal.com</p>
            <p style="font-size: 0.85rem; font-weight: 600; color: #002b54;"><i class="fas fa-phone-alt" style="color: #009fe3; margin-right: 6px;"></i> +91- 78880 65557</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Location Map -->
    <section class="contact-map-section" style="padding: 0; background: #f8fafc; border-top: 1px solid #e2e8f0;">
      <div style="width: 100%; height: 380px; position: relative;">
        <iframe 
          title="Reliable Industries Headquarters Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3768.857640698188!2d72.84277637599026!3d19.157672249419163!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7b7ccb2db3c4b%3A0x6b5a34e565ea7e74!2sSaraf%20Kaskar%20Industrial%20Estate!5e0!3m2!1sen!2sin!4v1710000000000!5m2!1sen!2sin" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
/* Page Layout */
.contact-page {
  background-color: #fdfdfd;
}

/* Hero Section */
.contact-hero {
  background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%);
  color: white;
  padding: 80px 0 100px;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.contact-hero::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
  linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 30px 30px;
  opacity: 0.5;
  pointer-events: none;
}

.contact-hero .kicker {
  color: #009fe3;
  margin-bottom: 15px;
}

.contact-hero h1 {
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  font-weight: 800;
  margin-bottom: 20px;
  color: white;
}

.contact-hero p {
  font-size: 1.15rem;
  max-width: 700px;
  margin: 0 auto;
  color: #c2d5e6;
  line-height: 1.7;
}

/* Contact Content Section */
.contact-content {
  padding: 60px 0 100px;
  position: relative;
  z-index: 10;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 40px;
  align-items: start;
}

/* Contact Info Panel */
.contact-info-panel {
  padding: 20px 40px 0 0;
}

.contact-info-panel h2 {
  font-size: 2.2rem;
  font-weight: 800;
  color: #001a3b;
  line-height: 1.2;
  margin-bottom: 20px;
}

.contact-info-panel h2 .highlight {
  color: #009fe3;
}

.contact-info-panel .subtitle {
  font-size: 1.1rem;
  color: #555;
  margin-bottom: 40px;
  line-height: 1.6;
}

.info-blocks {
  display: flex;
  flex-direction: column;
  gap: 30px;
  margin-bottom: 40px;
}

.info-block {
  display: flex;
  align-items: flex-start;
  gap: 20px;
}

.icon-circle {
  width: 50px;
  height: 50px;
  background: rgba(0, 159, 227, 0.1);
  color: #009fe3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.info-text h3 {
  font-size: 1.1rem;
  font-weight: 700;
  color: #001a3b;
  margin-bottom: 5px;
}

.info-text p {
  font-size: 1rem;
  color: #666;
  line-height: 1.6;
}

.info-text a {
  color: #009fe3;
  text-decoration: none;
  font-weight: 500;
}

.info-text a:hover {
  text-decoration: underline;
}

.social-connect h3 {
  font-size: 1.1rem;
  font-weight: 700;
  color: #001a3b;
  margin-bottom: 15px;
}

.social-connect .social-links {
  display: flex;
  gap: 15px;
}

.social-connect .social-links a {
  width: 40px;
  height: 40px;
  background: #f0f4f8;
  color: #003B6D;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.social-connect .social-links a:hover {
  background: #009fe3;
  color: white;
  transform: translateY(-3px);
}

/* Form Panel */
.contact-form-panel {
  background: white;
  border-radius: 12px;
  padding: 50px;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  border: 1px solid #eaeaea;
}

.form-card h2 {
  font-size: 2rem;
  font-weight: 700;
  color: #001a3b;
  margin-bottom: 10px;
}

.form-card > p {
  color: #666;
  margin-bottom: 30px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: #001a3b;
  margin-bottom: 8px;
}

.form-group input,
.form-group textarea,
.form-group select {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #dcdcdc;
  border-radius: 6px;
  font-family: inherit;
  font-size: 1rem;
  color: #111;
  background-color: #fbfbfb;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
  outline: none;
  border-color: #009fe3;
  background-color: white;
  box-shadow: 0 0 0 3px rgba(0, 159, 227, 0.1);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #777;
}

.select-wrapper {
  position: relative;
}

.select-wrapper select {
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}

.select-icon {
  position: absolute;
  right: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: #888;
  pointer-events: none;
}

.form-submit-btn {
  width: 100%;
  padding: 16px;
  font-size: 1.1rem;
  border-radius: 6px;
  margin-top: 10px;
  background-color: #009fe3;
  border: none;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-submit-btn:hover {
  background-color: #007bb5;
}

.form-disclaimer {
  font-size: 0.8rem;
  color: #888;
  margin-top: 20px;
  text-align: center;
}

.form-disclaimer a {
  color: #009fe3;
  text-decoration: none;
}

/* Responsive */
@media (max-width: 991px) {
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 60px;
  }
  
  .contact-content {
    margin-top: 0;
    padding-top: 60px;
  }
  
  .contact-hero {
    padding: 60px 0;
  }
  
  .contact-info-panel {
    padding: 0;
  }
}

@media (max-width: 767px) {
  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
  
  .contact-form-panel {
    padding: 30px 20px;
  }
}
</style>
