---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms & Conditions of Sale | Reliable Industries" description="Review the terms and conditions of commercial quotation, manufacture, warranty, and supply of Reliable Industries mechanical seals and systems.">
  <Header />

  <!-- Hero Header -->
  <section style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 75px 0 85px; color: white; text-align: center;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">COMMERCIAL & CONTRACT TERMS</span>
      <h1 style="font-size: clamp(2.2rem, 3.5vw, 3rem); font-weight: 800; margin-bottom: 15px;">Terms & Conditions of Sale</h1>
      <p style="font-size: 1.05rem; color: #cbd5e1; max-width: 700px; margin: 0 auto;">
        Standard terms governing quotations, orders, fabrication, warranties, and supply contracts.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section style="padding: 70px 0 90px; background: #ffffff;">
    <div class="container" style="max-width: 900px;">
      <div style="background: #ffffff; border: 1px solid #eef2f6; border-radius: 8px; padding: 40px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); line-height: 1.8; color: #475569;">
        
        <h2 style="font-size: 1.4rem; font-weight: 800; color: #002b54; margin-bottom: 15px;">1. Quotations & Order Acceptance</h2>
        <p style="margin-bottom: 25px;">
          All formal commercial quotations issued by Reliable Industries are valid for a period of 30 days unless explicitly specified otherwise. Purchase orders are binding upon formal written order confirmation from Reliable Industries.
        </p>

        <h2 style="font-size: 1.4rem; font-weight: 800; color: #002b54; margin-bottom: 15px;">2. Manufacturing & Quality Inspection</h2>
        <p style="margin-bottom: 25px;">
          All items are manufactured in conformance with agreed purchase specifications and international standards (API 682, ISO 9001). Pre-dispatch inspection, MTR certification, and hydrostatic test reports will be supplied in accordance with the purchase agreement.
        </p>

        <h2 style="font-size: 1.4rem; font-weight: 800; color: #002b54; margin-bottom: 15px;">3. Warranty & Guarantee</h2>
        <p style="margin-bottom: 25px;">
          Reliable Industries warrants that all products supplied are free from defects in material and workmanship for a period of 12 months from the date of commissioning or 18 months from the date of shipment, whichever occurs first, provided products are installed, flushed, and operated strictly within certified operating parameters.
        </p>

        <h2 style="font-size: 1.4rem; font-weight: 800; color: #002b54; margin-bottom: 15px;">4. Force Majeure & Limitation of Liability</h2>
        <p style="margin-bottom: 25px;">
          Reliable Industries shall not be held liable for failure to perform or delays resulting from acts of God, extreme raw material embargoes, war, or governmental import/export sanctions. Total aggregate liability under any claim shall not exceed the purchase price of the specific item supplied.
        </p>

        <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 30px;">
          For commercial contracts and legal queries, contact <a href="mailto:contracts@reliableseal.com" style="color: #009fe3; font-weight: 600;">contracts@reliableseal.com</a>.
        </p>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
