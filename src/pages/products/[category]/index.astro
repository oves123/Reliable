---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import groq from 'groq';
import { urlFor } from '../../../utils/sanity';

import localProducts from '../../../data/products.json';

export async function getStaticPaths() {
  const products = await sanityClient.fetch(groq`*[_type == "product"]{
    category,
    categorySlug
  }`);
  const catMap = new Map();
  products.forEach((p: any) => catMap.set(p.category, p.categorySlug));
  (localProducts as any[]).forEach((lp: any) => {
    if (lp.category && lp.categorySlug && !catMap.has(lp.category)) {
      catMap.set(lp.category, lp.categorySlug);
    }
  });

  return Array.from(catMap.entries()).map(([cat, slug]) => ({
    params: { category: slug },
    props: { categoryName: cat }
  }));
}

const { categoryName } = Astro.props;
const categoryProductsData = await sanityClient.fetch(groq`*[_type == "product" && category == $cat]{
  name,
  "slug": slug.current,
  categorySlug,
  image,
  description
}`, { cat: categoryName });

const categoryProducts = categoryProductsData.map(p => ({
  ...p,
  image: p.image ? urlFor(p.image).url() : ''
}));

function getCleanProductName(name: string, slug: string) {
  let cleanName = name || '';
  cleanName = cleanName.replace(/\b(Inside|Outside)\s*(Mounting|Mounted)?\b\s*/gi, '');
  const numMatch = (slug || '').match(/-(\d+)$/);
  if (numMatch && !cleanName.match(new RegExp('\\b' + numMatch[1] + '\\b'))) {
    if (/Series$/i.test(cleanName.trim())) {
      cleanName = cleanName.trim() + ' ' + numMatch[1];
    }
  }
  return cleanName.replace(/\s+/g, ' ').trim();
}

const localMatches = (localProducts as any[]).filter(p => 
  (p.category === categoryName || p.categorySlug === Astro.params.category) &&
  p.name !== 'Special Seal' && 
  !p.slug?.includes('special-seal') &&
  !p.name?.includes('Dairy Used') &&
  p.categorySlug !== 'dairy-seal' &&
  p.slug !== 'reliable-cartridge-seal-series-50' &&
  p.slug !== 'rdf-h-200-this-is-hydraulic-rotating-union-32' &&
  p.id !== 32
);

for (const lp of localMatches) {
  if (!categoryProducts.some((cp: any) => cp.slug === lp.slug)) {
    categoryProducts.push({
      name: getCleanProductName(lp.name, lp.slug),
      slug: lp.slug,
      categorySlug: lp.categorySlug,
      image: lp.image || (lp.img ? '/' + lp.img : ''),
      description: lp.description || ''
    });
  }
}
---
<Layout>
  <Header />
  <style>
      .product-card {
          border: 1px solid #eaeaea; 
          border-radius: 8px; 
          overflow: hidden; 
          transition: transform 0.2s ease, box-shadow 0.2s ease;
          background: white;
          display: flex;
          flex-direction: column;
          height: 100%;
      }
      .product-card:hover {
          transform: translateY(-4px);
          box-shadow: 0 12px 24px rgba(0,0,0,0.08);
          border-color: #d0d0d0;
      }
      .card-figure {
          margin: 0; 
          padding: 8px 12px; 
          text-align: center; 
          background: #ffffff; 
          border-bottom: 1px solid #f0f0f0;
          flex-shrink: 0;
          height: 250px;
          display: flex;
          align-items: center;
          justify-content: center;
      }
      .card-img {
          height: 100%; 
          width: 100%; 
          max-height: 235px; 
          object-fit: contain; 
          transition: transform 0.35s ease;
      }
      .product-card:hover .card-img {
          transform: scale(1.08);
      }
      .card-content {
          padding: 20px 22px; 
          display: flex;
          flex-direction: column;
          flex-grow: 1;
      }
      .card-title {
          font-size: 1.25rem; 
          font-weight: 600; 
          color: #222; 
          margin-bottom: 12px;
          transition: color 0.2s;
          line-height: 1.4;
      }
      .product-card:hover .card-title {
          color: #009fe3;
      }
      .card-desc {
          color: #666; 
          font-size: 0.95rem; 
          line-height: 1.5; 
          margin-bottom: 20px; 
          display: -webkit-box; 
          -webkit-line-clamp: 3; 
          -webkit-box-orient: vertical; 
          overflow: hidden;
          flex-grow: 1;
      }
      .card-link {
          display: inline-block; 
          color: #009fe3; 
          font-weight: 600; 
          text-decoration: none; 
          font-size: 0.95rem;
          transition: opacity 0.2s;
          margin-top: auto;
      }
      .card-link:hover {
          opacity: 0.8;
      }
  </style>

  <section class="page-title" style="background-color: #001a3b; padding: 40px 0; color: white;">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
          <div>
              <h1 style="font-size: 2.2rem; font-weight: 700; margin: 0 0 10px 0; letter-spacing: 0.5px;">{categoryName}</h1>
              <div style="color: #a0aec0; font-weight: 500; font-size: 0.95rem;">
                  <a href="/" style="color: white; text-decoration: none;">Home</a> <span style="margin: 0 10px;">/</span>
                  <a href="/products" style="color: white; text-decoration: none;">Products</a> <span style="margin: 0 10px;">/</span>
                  <span style="color: #009fe3;">{categoryName}</span>
              </div>
          </div>
      </div>
  </section>

  <section class="products-grid" style="padding: 60px 0 80px; background: #fff;">
      <div class="container">
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 30px;">
              {categoryProducts.map(p => (
                  <div class="product-card">
                      <figure class="card-figure">
                          <a href={`/products/${p.categorySlug}/${p.slug}`} style="display: block;">
                              <img src={p.image} alt={p.name} class="card-img">
                          </a>
                      </figure>
                      <div class="card-content">
                          <h4 class="card-title">
                              <a href={`/products/${p.categorySlug}/${p.slug}`} style="color: inherit; text-decoration: none;">{p.name}</a>
                          </h4>
                          <p class="card-desc">
                              {p.description}
                          </p>
                          <a href={`/products/${p.categorySlug}/${p.slug}`} class="card-link">View Details & Specs &rarr;</a>
                      </div>
                  </div>
              ))}
          </div>
      </div>
  </section>
  <Footer />
</Layout>
