---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { sanityClient } from 'sanity:client';
import groq from 'groq';
import { urlFor } from '../../../utils/sanity';

import localProducts from '../../../data/products.json';

export async function getStaticPaths() {
  const products = await sanityClient.fetch(groq`*[_type == "product"]{
    "slug": slug.current,
    categorySlug,
    category
  }`);
  const paths = [...products];
  for (const lp of (localProducts as any[])) {
    if (lp.slug && !paths.some(p => p.slug === lp.slug)) {
      paths.push({
        slug: lp.slug,
        categorySlug: lp.categorySlug,
        category: lp.category
      });
    }
  }
  return paths.map(product => ({
    params: { category: product.categorySlug, slug: product.slug },
    props: { category: product.category, slug: product.slug },
  }));
}

const { category, slug } = Astro.props;
const fetchedProduct = await sanityClient.fetch(groq`*[_type == "product" && slug.current == $slug][0]`, { slug });
const localProd = (localProducts as any[]).find(p => p.slug === slug || p.slug === fetchedProduct?.slug || p.name === fetchedProduct?.name);

const product = fetchedProduct || (localProd ? {
  name: localProd.name,
  slug: localProd.slug,
  category: localProd.category,
  categorySlug: localProd.categorySlug,
  description: localProd.description,
  features: localProd.features || [],
  specs: localProd.specs || {},
  image: localProd.image || (localProd.img ? '/' + localProd.img : '')
} : null);

if (product?.image && typeof product.image === 'object') {
  product.image = urlFor(product.image).url();
}
if (product) {
  product.slug = product.slug?.current || product.slug;
}

// Collect 2 to 3 gallery images (original photo + technical diagram / graphic)
const galleryImages: { url: string; label: string; type: string }[] = [];
if (product.image) {
  galleryImages.push({ url: product.image, label: 'Product Photo', type: 'photo' });
}
if (localProd) {
  if (localProd.image && !galleryImages.some(img => img.url === localProd.image)) {
    galleryImages.push({ url: localProd.image, label: 'Main View', type: 'photo' });
  }
  if (localProd.images && Array.isArray(localProd.images)) {
    localProd.images.forEach((imgSrc: string, i: number) => {
      const fullPath = imgSrc.startsWith('/') ? imgSrc : '/' + imgSrc;
      if (!galleryImages.some(img => img.url === fullPath)) {
        const isDiagram = fullPath.includes('_gr') || fullPath.includes('diagram');
        galleryImages.push({
          url: fullPath,
          label: isDiagram ? 'Technical Diagram / Cutaway' : `Engineering View ${i + 1}`,
          type: isDiagram ? 'diagram' : 'photo'
        });
      }
    });
  }
}
if (galleryImages.length === 1) {
  galleryImages.push({
    url: '/images/engineering_cad.jpg',
    label: 'Technical Schematic / CAD',
    type: 'diagram'
  });
}

// Filter out 'Special Seal', 'Dairy Used' products, the 4th cartridge seal (series-50), and duplicate hydraulic rotary union (id 32) matching dropdown
const dropdownProducts = (localProducts as any[]).filter(p => 
  p.name !== 'Special Seal' && 
  !p.slug?.includes('special-seal') &&
  !p.name?.includes('Dairy Used') &&
  p.categorySlug !== 'dairy-seal' &&
  p.slug !== 'reliable-cartridge-seal-series-50' &&
  p.slug !== 'rdf-h-200-this-is-hydraulic-rotating-union-32' &&
  p.id !== 32
);

// Helper to clean product names in sidebar (remove Inside/Outside and append series number to differentiate)
function getDropdownProductName(prod: any) {
  let name = prod.name || '';
  name = name.replace(/\b(Inside|Outside)\s*(Mounting|Mounted)?\b\s*/gi, '');
  const numMatch = (prod.slug || '').match(/-(\d+)$/);
  if (numMatch && !name.match(new RegExp('\\b' + numMatch[1] + '\\b'))) {
    if (/Series$/i.test(name.trim())) {
      name = name.trim() + ' ' + numMatch[1];
    }
  }
  return name.replace(/\s+/g, ' ').trim();
}

function getProductSpecs(prod: any) {
  const specs: { label: string; value: string }[] = [];
  const raw = prod.specs || {};

  const rawSize = raw.Size || prod.Size || raw['Rotary joint size available'] || prod.rotary_joint_size_available;
  if (rawSize) {
    const cleanedSize = String(rawSize)
      .replace(/--/g, ' - ')
      .replace(/- -/g, ' - ')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Size', value: cleanedSize });
  }

  const rawTemp = raw.Temp || prod.Temp || raw['Temperature range'] || prod.temperature_range;
  if (rawTemp) {
    const cleanedTemp = String(rawTemp)
      .replace(/\bTO\b/gi, 'to')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Temp', value: cleanedTemp });
  }

  if (specs.length < 2) {
    const rawPress = raw.Press || prod.Press || raw.Prees || prod.Prees || raw.Pressure || prod.pressure;
    if (rawPress) {
      specs.push({ label: 'Press', value: String(rawPress).trim() });
    }
  }

  if (specs.length === 0 && (raw.Capacity || prod.Capacity)) {
    specs.push({ label: 'Cap', value: String(raw.Capacity || prod.Capacity).trim() });
  }

  return specs;
}

// Subcategory mapping identical to Header mega-menu dropdown
const subCategoriesDef = [
  {
    title: 'Multi Spring Seal',
    slug: 'multi-spring-series-seal',
    match: (p: any) => p.categorySlug === 'multi-spring-series-seal' || p.categorySlug === 'mechanical-seal'
  },
  {
    title: 'Single Spring Seal',
    slug: 'single-spring-series-seal',
    match: (p: any) => p.categorySlug === 'single-spring-series-seal'
  },
  {
    title: 'Rubber Bellow Seal',
    slug: 'water-seal',
    match: (p: any) => p.categorySlug === 'water-seal'
  },
  {
    title: 'High Temperature Seal',
    slug: 'high-temp-seal',
    match: (p: any) => p.categorySlug === 'high-temp-seal'
  },
  {
    title: 'Cartridge Seal',
    slug: 'cartridge-seal',
    match: (p: any) => p.categorySlug === 'cartridge-seal'
  },
  {
    title: 'Reactor Seal',
    slug: 'reactor-seal',
    match: (p: any) => p.categorySlug === 'reactor-seal'
  },
  {
    title: 'Agitator Seal',
    slug: 'agitator-seal',
    match: (p: any) => p.categorySlug === 'agitator-seal'
  },
  {
    title: 'Water Rotary Joints',
    slug: 'water-rotary-joints',
    match: (p: any) => p.categorySlug === 'water-rotary-joints'
  },
  {
    title: 'Hot Oil Rotary Joints',
    slug: 'hot-oil-rotary-joints',
    match: (p: any) => p.categorySlug === 'hot-oil-rotary-joints'
  },
  {
    title: 'Steam Rotary Joints',
    slug: 'steam-rotary-joints',
    match: (p: any) => p.categorySlug === 'steam-rotary-joints'
  },
  {
    title: 'Hydraulic Rotary Joints',
    slug: 'hydrolic-rotary-joints',
    match: (p: any) => p.categorySlug === 'hydrolic-rotary-joints'
  },
  {
    title: 'High Temperature Rotary Joint',
    slug: 'high-temp-rotary-joints',
    match: (p: any) => p.categorySlug === 'high-temp-rotary-joints'
  },
  {
    title: 'Thermosyphon System',
    slug: 'thermosyphon',
    match: (p: any) => p.categorySlug === 'thermosyphon'
  },
  {
    title: 'Heat Exchanger System',
    slug: 'heat-exchanged-system',
    match: (p: any) => p.categorySlug === 'heat-exchanged-system'
  },
  {
    title: 'Rotary Joints',
    slug: 'rotary-joints',
    match: (p: any) => p.categorySlug === 'rotary-joints'
  }
];

const activeSubDef = subCategoriesDef.find(sub => sub.match(product) || sub.slug === product.categorySlug);

let relatedProducts = activeSubDef 
  ? dropdownProducts.filter(p => activeSubDef.match(p))
  : dropdownProducts.filter(p => p.categorySlug === product.categorySlug || p.category === product.category);

if (relatedProducts.length === 0) {
  relatedProducts = [product];
}

const sidebarTitle = activeSubDef?.title || product.category;
---
<Layout>
  <Header />
  <section class="page-title" style="background-color: #001a3b; padding: 25px 0; color: white;">
      <div class="container">
          <h1 style="font-size: 2.2rem; font-weight: 700; margin: 0 0 8px 0;">{product.name}</h1>
          <div style="color: #009fe3; font-weight: 500; font-size: 0.95rem;">
              <a href="/" style="color: #e2e8f0; text-decoration: none;">Home</a> <span style="margin: 0 10px; color: #718096;">/</span>
              <a href={`/products/${product.categorySlug}`} style="color: #e2e8f0; text-decoration: none;">{product.category}</a> <span style="margin: 0 10px; color: #718096;">/</span>
              <span style="color: #009fe3;">{product.name}</span>
          </div>
      </div>
  </section>

  <section class="product-details" style="padding: 30px 0 60px; background: #fdfdfd;">
      <div class="container">
          <div class="product-grid">
              
              <!-- Sidebar -->
              <div class="sidebar">
                  <div class="category-nav" style="background: white; border: 1px solid #eaeaea; border-radius: 8px; padding: 20px; margin-bottom: 30px;">
                      <div style="margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid #009fe3; display: flex; align-items: center; justify-content: space-between;">
                          <h3 style="font-size: 1.15rem; font-weight: 700; color: #001a3b; margin: 0;">{sidebarTitle}</h3>
                          <span style="font-size: 0.72rem; font-weight: 700; color: #009fe3; background: #e0f2fe; padding: 2px 8px; border-radius: 10px;">{relatedProducts.length} Products</span>
                      </div>
                      <div class="sidebar-products-list">
                          {relatedProducts.map((p: any) => {
                              const isActive = p.slug === product.slug;
                              const specs = getProductSpecs(p);
                              return (
                                  <a href={`/products/${p.categorySlug}/${p.slug}`} 
                                     class={`sidebar-product-card ${isActive ? 'active' : ''}`}>
                                      <div class="sidebar-card-header">
                                          <span class="sidebar-product-name">{getDropdownProductName(p)}</span>
                                          {isActive && (
                                              <i class="fas fa-check-circle active-icon"></i>
                                          )}
                                      </div>
                                      {specs.length > 0 && (
                                          <div class="sidebar-product-specs">
                                              {specs.slice(0, 2).map((s) => (
                                                  <span class="spec-badge">
                                                      <span class="spec-label">{s.label}:</span>
                                                      <span class="spec-val">{s.value}</span>
                                                  </span>
                                              ))}
                                          </div>
                                      )}
                                  </a>
                              );
                          })}
                      </div>
                  </div>

                  <div class="brochure-box" style="background: white; border: 1px solid #eaeaea; padding: 25px; border-radius: 8px; text-align: center; margin-bottom: 30px;">
                      <i class="fas fa-file-pdf" style="font-size: 2.5rem; color: #e2574c; margin-bottom: 15px;"></i>
                      <h3 style="font-size: 1.25rem; font-weight: 700; color: #001a3b; margin-bottom: 10px;">Product Brochure</h3>
                      <p style="color: #666; font-size: 0.9rem; margin-bottom: 20px;">Download the full technical specifications and dimensions.</p>
                      <a href="/brochures/product_brochure.pdf" download="Reliable_Product_Brochure.pdf" style="display: block; padding: 12px; background: #001a3b; color: white; border-radius: 5px; font-weight: 600; text-decoration: none; transition: background 0.3s;" onmouseover="this.style.background='#009fe3'" onmouseout="this.style.background='#001a3b'">Download PDF</a>
                  </div>

                  <div class="contact-box" style="background: #001a3b; color: white; padding: 30px; border-radius: 8px; text-align: center;">
                      <i class="fas fa-headset" style="font-size: 3rem; color: #009fe3; margin-bottom: 20px;"></i>
                      <h3 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 15px;">Need Technical Support?</h3>
                      <p style="color: #a0aec0; margin-bottom: 20px; font-size: 0.95rem;">Contact our engineering team for custom solutions.</p>
                      <a href="tel:+917888065557" style="display: block; padding: 12px; background: white; color: #001a3b; border-radius: 50px; font-weight: 700; text-decoration: none;">+91 78880 65557</a>
                  </div>
              </div>
              
              <!-- Main Content -->
              <div class="content">
                  
                  <!-- Product Image Zoom & Multi-Image Gallery Switcher (PDF Page 9) -->
                  <div class="gallery-wrapper" style="margin-bottom: 35px;">
                      <div class="zoom-container" style="text-align: center; background: #f9f9f9; border-radius: 8px; overflow: hidden; position: relative; cursor: crosshair; padding: 25px; border: 1px solid #edf1f4;">
                          <img id="product-img" src={galleryImages[0].url} alt={product.name} style="width: 100%; height: auto; max-height: 480px; object-fit: contain; display: block; margin: 0 auto; transition: transform 0.1s ease-out; transform-origin: center center; mix-blend-mode: multiply;">
                      </div>

                      {galleryImages.length > 1 && (
                          <div class="gallery-thumbnails" style="display: flex; gap: 12px; margin-top: 14px; justify-content: center; flex-wrap: wrap;">
                              {galleryImages.map((img, idx) => (
                                  <button type="button" 
                                          class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
                                          onclick={`switchGalleryImage('${img.url}', this)`}
                                          style={`display: flex; align-items: center; gap: 8px; padding: 8px 16px; background: white; border: 2px solid ${idx === 0 ? '#009fe3' : '#e2e8f0'}; border-radius: 6px; cursor: pointer; transition: all 0.2s;`}>
                                      <i class={img.type === 'diagram' ? 'fas fa-drafting-compass' : 'fas fa-camera'} style="color: #009fe3; font-size: 0.95rem;"></i>
                                      <span style="font-size: 0.85rem; font-weight: 600; color: #001a3b;">{img.label}</span>
                                  </button>
                              ))}
                          </div>
                      )}
                  </div>
                  
                  <script is:inline>
                      function switchGalleryImage(src, btn) {
                          const img = document.getElementById('product-img');
                          if (img) img.src = src;
                          document.querySelectorAll('.thumb-btn').forEach(b => {
                              b.style.borderColor = '#e2e8f0';
                          });
                          if (btn) btn.style.borderColor = '#009fe3';
                      }

                      document.addEventListener('DOMContentLoaded', () => {
                          const container = document.querySelector('.zoom-container');
                          const img = document.getElementById('product-img');

                          if(container && img) {
                              container.addEventListener('mousemove', (e) => {
                                  const rect = container.getBoundingClientRect();
                                  const x = (e.clientX - rect.left) / rect.width;
                                  const y = (e.clientY - rect.top) / rect.height;

                                  img.style.transformOrigin = `${x * 100}% ${y * 100}%`;
                                  img.style.transform = 'scale(2.2)';
                              });

                              container.addEventListener('mouseleave', () => {
                                  img.style.transform = 'scale(1)';
                                  img.style.transformOrigin = 'center center';
                              });
                          }
                      });
                  </script>
                  
                  <h2 style="font-size: 1.8rem; font-weight: 700; color: #001a3b; margin-bottom: 15px;">Overview</h2>
                  <p style="font-size: 1.05rem; line-height: 1.8; color: #4a5568; margin-bottom: 35px;">
                      {product.description}
                  </p>
                  
                  <div class="specs-grid">
                      <div>
                          <h3 style="font-size: 1.35rem; font-weight: 700; color: #001a3b; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                              <i class="fas fa-check-circle" style="color: #009fe3;"></i> Key Features
                          </h3>
                          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
                              {product.features.map((f: string) => (
                                  <li style="display: flex; align-items: flex-start; gap: 12px; color: #4a5568; font-size: 0.95rem; line-height: 1.5; background: #fbfcfd; padding: 12px 14px; border-radius: 6px; border: 1px solid #edf2f7;">
                                      <i class="fas fa-check-circle" style="color: #009fe3; margin-top: 3px; font-size: 1rem; flex-shrink: 0;"></i>
                                      <span>{f}</span>
                                  </li>
                              ))}
                          </ul>
                      </div>
                      
                      <div>
                          <h3 style="font-size: 1.5rem; font-weight: 700; color: #001a3b; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                              <i class="fas fa-sliders-h" style="color: #009fe3;"></i> Technical Specs
                          </h3>
                          <div style="background: #f9f9f9; border-radius: 8px; padding: 20px;">
                              <ul style="list-style: none; padding: 0; margin: 0;">
                                  {Object.entries(product.specs).map(([key, value]) => (
                                      <li style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid #eaeaea; color: #555;">
                                          <strong style="color: #001a3b;">{key}</strong>
                                          <span>{value}</span>
                                      </li>
                                  ))}
                              </ul>
                          </div>
                      </div>
                  </div>
              </div>

          </div>
      </div>
  </section>
  
  <Footer />
</Layout>

<style>
/* Default Desktop Layout */
.product-grid {
  display: grid;
  grid-template-columns: 310px 1fr;
  gap: 40px;
  align-items: start;
}

/* Sidebar Product Cards matching Screenshot 2 */
.sidebar-products-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.sidebar-product-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 10px 13px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  text-decoration: none;
  transition: all 0.18s ease;
  min-height: 60px;
  box-sizing: border-box;
}

.sidebar-product-card:hover {
  background: #ffffff;
  border-color: #009fe3;
  box-shadow: 0 4px 12px rgba(0, 159, 227, 0.12);
  transform: translateY(-1px);
}

.sidebar-product-card.active {
  background: #009fe3 !important;
  border-color: #0082ba !important;
  box-shadow: 0 4px 14px rgba(0, 159, 227, 0.25) !important;
}

.sidebar-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 5px;
}

.sidebar-product-name {
  font-size: 0.84rem;
  font-weight: 700;
  color: #001a3b;
  line-height: 1.25;
  transition: color 0.18s ease;
}

.sidebar-product-card.active .sidebar-product-name {
  color: #ffffff !important;
}

.sidebar-product-card .active-icon {
  color: #ffffff;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.sidebar-product-specs {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  align-items: center;
  width: 100%;
}

.sidebar-product-card .spec-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.68rem;
  font-weight: 500;
  color: #334155;
  background: #edf2f7;
  padding: 2px 7px;
  border-radius: 4px;
  border: 1px solid #e2e8f0;
  line-height: 1.25;
  white-space: nowrap;
  transition: all 0.18s ease;
}

.sidebar-product-card.active .spec-badge {
  background: rgba(255, 255, 255, 0.2) !important;
  border-color: rgba(255, 255, 255, 0.35) !important;
  color: #ffffff !important;
}

.sidebar-product-card .spec-badge .spec-label {
  font-weight: 700;
  color: #64748b;
  font-size: 0.65rem;
  text-transform: uppercase;
}

.sidebar-product-card.active .spec-badge .spec-label {
  color: #e0f2fe !important;
}

.sidebar-product-card .spec-badge .spec-val {
  font-weight: 600;
  color: #0f172a;
  font-size: 0.68rem;
}

.sidebar-product-card.active .spec-badge .spec-val {
  color: #ffffff !important;
}

.content {
  background: white; 
  padding: 40px; 
  border-radius: 8px; 
  border: 1px solid #eaeaea;
}

.specs-grid {
  display: grid; 
  grid-template-columns: 1fr 1fr; 
  gap: 40px;
}

/* Responsive layout for the grid */
@media (max-width: 991px) {
  .product-grid {
    display: flex;
    flex-direction: column-reverse;
    gap: 40px;
  }
  .sidebar {
    width: 100%;
  }
  .content {
    width: 100%;
    padding: 20px;
  }
  .specs-grid {
    grid-template-columns: 1fr;
  }
  .page-title h1 {
    font-size: 2rem !important;
  }
}

@media (max-width: 767px) {
  .product-grid {
    gap: 30px;
  }
}
</style>
