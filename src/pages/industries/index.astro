---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import industries from '../../data/industries.json';
---

<Layout title="Industries We Serve | Reliable Industries - Pioneer in Sealing Technology" description="Explore the 10 global industries served by Reliable Industries. From Oil & Gas and Chemical Processing to Water Systems and Refrigeration, our mechanical seals and rotary joints deliver zero-leakage performance.">
  <Header />

  <!-- Hero Header -->
  <section class="industry-hub-hero" style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 90px 0 100px; color: white; text-align: center; position: relative;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 2px; display: block; margin-bottom: 14px;">GLOBAL APPLICATIONS & EXCELLENCE</span>
      <h1 style="font-size: clamp(2.4rem, 4vw, 3.5rem); font-weight: 800; margin-bottom: 20px; line-height: 1.15;">Engineered Sealing Solutions For 10 Major Industries</h1>
      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 820px; margin: 0 auto; line-height: 1.6;">
        From extreme offshore hydrocarbon pressures to sterile sanitary pharmaceutical reactors, Reliable Industries manufactures heavy-duty mechanical seals and rotary unions proven in demanding industrial environments.
      </p>
    </div>
  </section>

  <!-- Industries Listing Grid -->
  <section style="padding: 80px 0; background: #f8fafc;">
    <div class="container">
      <div style="text-align: center; max-width: 760px; margin: 0 auto 50px auto;">
        <span style="color: #009fe3; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 8px;">CATALOG OF INDUSTRIAL SECTORS</span>
        <h2 style="font-size: 2.2rem; font-weight: 800; color: #002b54; margin-bottom: 15px;">Reliable Performance Under Critical Operating Conditions</h2>
        <p style="color: #64748b; font-size: 1rem; line-height: 1.6;">Select an industry below to review operating parameters, recommended sealing technologies, and engineering case studies.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 35px;">
        {industries.map((ind) => (
          <article class="industry-card" style="background: #ffffff; border-radius: 12px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 8px 24px rgba(0, 43, 73, 0.06); display: flex; flex-direction: column; transition: transform 0.3s ease, box-shadow 0.3s ease;">
            <div style="height: 220px; overflow: hidden; position: relative;">
              <img src={ind.image} alt={ind.title} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;" loading="lazy" />
              <div style="position: absolute; top: 16px; left: 16px; background: rgba(0, 26, 59, 0.85); backdrop-filter: blur(4px); color: #009fe3; font-size: 0.75rem; font-weight: 800; letter-spacing: 1.5px; padding: 6px 14px; border-radius: 4px; text-transform: uppercase; border: 1px solid rgba(0, 159, 227, 0.3);">
                {ind.tag}
              </div>
            </div>

            <div style="padding: 30px; display: flex; flex-direction: column; flex-grow: 1;">
              <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
                <i class={`${ind.icon}`} style="font-size: 1.4rem; color: #009fe3;"></i>
                <h3 style="font-size: 1.4rem; font-weight: 700; color: #002b54; margin: 0;">
                  <a href={`/industries/${ind.slug}`} style="color: inherit; text-decoration: none;">{ind.title}</a>
                </h3>
              </div>

              <!-- Official Brochure Statement -->
              <blockquote style="margin: 0 0 20px 0; padding: 12px 16px; background: #f0f7fc; border-left: 3px solid #009fe3; border-radius: 0 6px 6px 0; font-size: 0.92rem; color: #334155; line-height: 1.6; font-style: italic;">
                "{ind.desc}"
              </blockquote>

              <div style="margin-bottom: 25px; flex-grow: 1;">
                <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; margin-bottom: 8px;">Key Applications:</div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                  {ind.keyEquipment.slice(0, 3).map((eq) => (
                    <span style="font-size: 0.78rem; background: #f1f5f9; color: #475569; padding: 4px 10px; border-radius: 4px; font-weight: 600;">{eq}</span>
                  ))}
                  {ind.keyEquipment.length > 3 && (
                    <span style="font-size: 0.78rem; color: #009fe3; padding: 4px 6px; font-weight: 700;">+{ind.keyEquipment.length - 3} more</span>
                  )}
                </div>
              </div>

              <div style="border-top: 1px solid #f1f5f9; padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                <a href={`/industries/${ind.slug}`} style="color: #009fe3; font-weight: 700; text-decoration: none; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 6px;">
                  <span>Explore Industry Solutions</span>
                  <i class="fas fa-arrow-right" style="font-size: 0.85rem;"></i>
                </a>
                <a href={`/contact?inquiry=${encodeURIComponent(ind.title)}`} style="color: #64748b; font-size: 0.85rem; text-decoration: none; font-weight: 600;">
                  Inquire
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Global Engineering Consultation CTA -->
  <section style="background: linear-gradient(135deg, #002b54 0%, #001a35 100%); padding: 70px 0; color: white; text-align: center;">
    <div class="container">
      <span style="color: #009fe3; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">ENGINEERED APPLICATION SUPPORT</span>
      <h2 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 16px;">Don't See Your Specific Process Fluid Listed?</h2>
      <p style="color: #cbd5e1; font-size: 1.1rem; max-width: 680px; margin: 0 auto 30px auto; line-height: 1.6;">
        Our Mumbai engineering center custom designs mechanical seal faces, exotic metallurgy barriers, and specialized rotary pressure joints for one-off and extreme industrial specifications.
      </p>
      <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
        <a href="/contact" class="btn btn-primary" style="background: #009fe3; border: none; padding: 14px 35px; border-radius: 50px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Consult An Engineer</a>
        <a href="/brochures/product_brochure.pdf" download="Reliable_Product_Brochure.pdf" class="btn" style="background: transparent; color: white; border: 2px solid rgba(255,255,255,0.4); padding: 12px 30px; border-radius: 50px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Download Catalog (PDF)</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .industry-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 43, 73, 0.12) !important;
  }
  .industry-card:hover img {
    transform: scale(1.05);
  }
</style>

