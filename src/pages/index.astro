---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import productsData from '../data/products.json';
import { sanityClient } from 'sanity:client';
import groq from 'groq';

const homePage = await sanityClient.fetch(groq`*[_type == "homePage"][0]`);

const heroSubtitle = homePage?.heroSubtitle || "RELY ON EXCELLENCE";
const heroTitle = homePage?.heroTitle || "High-Performance<br>Mechanical Seals.";
const heroDescription = homePage?.heroDescription || "Providing reliable sealing solutions for industrial rotating equipment worldwide. We offer extensive support in the field of sealing technology as a planning partner, supplier, and service partner.";
const missionSubtitle = homePage?.missionSubtitle || "OUR MISSION";
const missionTitle = homePage?.missionTitle || "Continuous innovations in sealing applications.";
const missionDescription = homePage?.missionDescription || "Belief in the capabilities of our people to rapidly transfer ideas to reality and a firm faith in promising leak-free, maintenance-free, high quality standard products.";

const stats = homePage?.stats || [
  { number: 50, suffix: '+', label: 'Countries Served' },
  { number: 10000, suffix: '+', label: 'Global Installations' },
  { number: 100, suffix: '%', label: 'Quality Assured' }
];

const whyChooseUsTitle = homePage?.whyChooseUsTitle || "Comprehensive seal service for industrial facilities";
const whyChooseUsDescription = homePage?.whyChooseUsDescription || "Production systems need to work safely, reliably, and with maximum cost-effectiveness. So it is good to have access to an expert and efficient partner. With Reliable Industries, we offer customized service programs and flexible service for seals and gaskets. The service portfolio extends from consulting and engineering to individually-tailored service contracts.";
const features = homePage?.features || [
  { title: 'Specialist', description: 'Expert technical advice tailored to your specific application requirements.' },
  { title: 'Reliable', description: 'Dependable products and services that ensure continuous operation.' },
  { title: 'Fast', description: 'Quick turnaround times to minimize your system downtime.' },
  { title: 'Global', description: 'Worldwide support network ready to assist wherever you are.' }
];
---
<Layout title={homePage?.seoTitle} description={homePage?.seoDescription}>
  <Header />
      <!-- Hero Section -->
    <section class="hero carousel-container">
        <div class="carousel-track" id="hero-carousel-track">
            <!-- Slide 1 (Original) -->
            <div class="carousel-slide" style="position: relative; overflow: hidden;">
                <!-- Fallback background image (sits behind video) -->
                <div class="hero-image" style="background-image: url('images/hero_mechanical_seal.png'); background-size: cover; background-position: center; position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;"></div>
                
                <!-- Authentic CNC Manufacturing Video Background (Local MP4) -->
                <video autoplay loop muted playsinline style="position: absolute; top: 50%; left: 50%; min-width: 100%; min-height: 100%; width: auto; height: auto; transform: translateX(-50%) translateY(-50%); z-index: 1; object-fit: cover; opacity: 0.8;">
                    <source src="images/industry_video.mp4" type="video/mp4">
                </video>
                
                <div class="hero-overlay" style="z-index: 2; position: absolute; top: 0; left: 0; width: 100%; height: 100%;"></div>
                <div class="container" style="position: relative; z-index: 3;">
                    <div class="hero-content" style="max-width: 900px;">
                        <span class="hero-kicker"
                            style="font-size: 0.75rem; margin-bottom: 0.75rem; display: block; color: var(--color-primary-navy);">{heroSubtitle}</span>
                        <h1 class="hero-title"
                            style="font-size: clamp(2.5rem, 4vw, 3.2rem); max-width: 100%; margin-bottom: 1rem; line-height: 1.1;" set:html={heroTitle}>
                        </h1>
                        <p class="hero-subtitle"
                            style="max-width: 600px; margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.5;">{heroDescription}</p>
                        <div class="hero-actions" style="margin-bottom: 2rem;">
                            <a href="#" class="btn btn-primary"
                                style="background-color: var(--color-primary-navy); border-color: var(--color-primary-navy); border-radius: 0; padding: 0.8rem 2.5rem; font-size: 0.95rem;">Learn
                                more</a>
                        </div>
                        <div class="hero-badge"
                            style="width: 35px; height: 35px; border-radius: 50%; border: 2px solid var(--text-main); display: flex; align-items: center; justify-content: center; color: var(--text-main);">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                <path d="M9 12l2 2 4-4"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 2 (Products) -->
            <div class="carousel-slide">
                <div class="hero-image"
                    style="background-image: url('images/product_seal_2_1790081868989.jpg'); background-size: cover; background-position: center;">
                </div>
                <div class="hero-overlay"
                    style="background: linear-gradient(90deg, rgba(0, 159, 227, 1) 0%, rgba(0, 159, 227, 0.9) 45%, rgba(0, 159, 227, 0) 100%);">
                </div>
                <div class="container">
                    <div class="hero-content" style="max-width: 900px;">
                        <span class="hero-kicker"
                            style="font-size: 0.75rem; margin-bottom: 0.75rem; display: block; color: white;">ADVANCED
                            COMPONENTS</span>
                        <h1 class="hero-title"
                            style="font-size: clamp(2.5rem, 4vw, 3.2rem); max-width: 100%; margin-bottom: 1rem; line-height: 1.1; color: white;">
                            Comprehensive range of<br>mechanical seals.</h1>
                        <p class="hero-subtitle"
                            style="max-width: 600px; margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.5; color: white;">From RM
                            Series and Cartridge Seals to Rotary Pressure Joints, we offer Reliable sealing systems for
                            handling extreme and persistent sealing problems.</p>
                        <div class="hero-actions" style="margin-bottom: 2rem;">
                            <a href="#" class="btn btn-primary"
                                style="background-color: var(--color-accent-lime); border-color: var(--color-accent-lime); color: var(--color-primary-dark); border-radius: 0; padding: 0.8rem 2.5rem; font-size: 0.95rem;">View
                                Products</a>
                        </div>
                        <div class="hero-badge"
                            style="width: 35px; height: 35px; border-radius: 50%; background-color: white; display: flex; align-items: center; justify-content: center; color: var(--color-primary-dark);">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="8" x2="12" y2="16"></line>
                                <line x1="8" y1="12" x2="16" y2="12"></line>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Slide 3 (Mission) -->
            <div class="carousel-slide">
                <div class="hero-image"
                    style="background-image: url('images/mission_hero_bg.jpg'); background-size: cover; background-position: center;">
                </div>
                <div class="hero-overlay"
                    style="background: linear-gradient(90deg, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.9) 60%, rgba(255, 255, 255, 0.2) 100%);">
                </div>
                <div class="container">
                    <div class="hero-content" style="max-width: 900px;">
                        <span class="hero-kicker"
                            style="font-size: 0.75rem; margin-bottom: 0.75rem; display: block; color: var(--color-primary-navy);">{missionSubtitle}</span>
                        <h1 class="hero-title"
                            style="font-size: clamp(2.5rem, 4vw, 3.2rem); max-width: 100%; margin-bottom: 1rem; line-height: 1.1;" set:html={missionTitle}>
                        </h1>
                        <p class="hero-subtitle"
                            style="max-width: 600px; margin-bottom: 1.5rem; font-size: 1rem; line-height: 1.5;">{missionDescription}</p>
                        <div class="hero-actions" style="margin-bottom: 2rem;">
                            <a href="#" class="btn btn-primary"
                                style="background-color: var(--color-primary-navy); border-color: var(--color-primary-navy); border-radius: 0; padding: 0.8rem 2.5rem; font-size: 0.95rem;">Who
                                We Are</a>
                        </div>
                        <div class="hero-badge"
                            style="width: 35px; height: 35px; border-radius: 50%; border: 2px solid var(--text-main); display: flex; align-items: center; justify-content: center; color: var(--text-main);">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon
                                    points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2">
                                </polygon>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Carousel Controls -->
        <button class="carousel-control prev" onclick="moveHeroSlide(-1)">&#10094;</button>
        <button class="carousel-control next" onclick="moveHeroSlide(1)">&#10095;</button>
        <div class="carousel-indicators">
            <button class="indicator active" onclick="setHeroSlide(0)"></button>
            <button class="indicator" onclick="setHeroSlide(1)"></button>
            <button class="indicator" onclick="setHeroSlide(2)"></button>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container stats-grid">
            <div class="stat-item" data-aos="zoom-in" data-aos-delay="0">
                <div class="stat-number" data-target="30">0</div>
                <div class="stat-label">Years of Experience</div>
            </div>
            {stats.map((stat: any, index: number) => (
                <div class="stat-item" data-aos="zoom-in" data-aos-delay={(index + 1) * 100}>
                    <div class="stat-number" data-target={stat.number}>0</div>
                    {stat.suffix && <span class="stat-plus">{stat.suffix}</span>}
                    <div class="stat-label">{stat.label}</div>
                </div>
            ))}
        </div>
    </section>

    <!-- Products Section -->
    <section class="products-section">
        <div class="container">
            <div class="section-header carousel-header" data-aos="fade-up">
                <div>
                    <span class="kicker">OUR PORTFOLIO</span>
                    <h2 style="margin-bottom: 10px;">Reliable Sealing Solutions</h2>
                    <p class="section-subtitle" style="margin-bottom: 0;">Discover our comprehensive range of high-performance seals, supply systems, and couplings engineered for the most demanding industrial environments.</p>
                </div>
                <div class="portfolio-controls" style="display: flex; gap: 10px;">
                    <button id="portfolio-prev" aria-label="Previous product" style="width: 45px; height: 45px; border-radius: 50%; border: 1px solid #ddd; background: white; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: 0.3s; color: #001a3b;" onmouseover="this.style.background='#f0f0f0'" onmouseout="this.style.background='white'">&#10094;</button>
                    <button id="portfolio-next" aria-label="Next product" style="width: 45px; height: 45px; border-radius: 50%; border: none; background: #009fe3; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: 0.3s; color: white;" onmouseover="this.style.background='#007ab0'" onmouseout="this.style.background='#009fe3'">&#10095;</button>
                </div>
            </div>
            <div class="product-grid">
                <!-- Product Card 1 -->
                <div class="product-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="product-image">
                        <img src="images/product_seal_1_1790081847592.jpg" alt="Mechanical Seals">
                    </div>
                    <div class="product-info">
                        <h3>Mechanical Seals</h3>
                        <p>High-end standard and customized seals for pumps, agitators, and compressors.</p>
                        <a href="/products/multi-spring-series-seal" class="learn-more">Learn more <span class="arrow">&#8594;</span></a>
                    </div>
                </div>
                <!-- Product Card 2 -->
                <div class="product-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="product-image">
                        <img src="images/product_seal_2_1790081868989.jpg" alt="Seal Supply Systems">
                    </div>
                    <div class="product-info">
                        <h3>Seal Supply Systems</h3>
                        <p>State-of-the-art systems to ensure optimal operating conditions for your seals.</p>
                        <a href="/products/thermosyphon" class="learn-more">Learn more <span class="arrow">&#8594;</span></a>
                    </div>
                </div>
                <!-- Product Card 3: Rotary Joints (Replaces Magnetic Couplings) -->
                <div class="product-card" data-aos="fade-up" data-aos-delay="300">
                    <div class="product-image">
                        <img src="images/sealproduct/waterrotatingunion.jpg" alt="Rotary Joints" style="object-fit: contain; padding: 10px;">
                    </div>
                    <div class="product-info">
                        <h3>Rotary Joints</h3>
                        <p>Reliable monoflow and duoflow rotating unions engineered for water, steam, hot oil, and hydraulic applications.</p>
                        <a href="/products/water-rotary-joints" class="learn-more">Learn more <span class="arrow">&#8594;</span></a>
                    </div>
                </div>
                <!-- Highlight Card -->
                <div class="product-card highlight-card" data-aos="fade-up" data-aos-delay="400">
                    <div class="highlight-content">
                        <h3>Custom Engineered Solutions</h3>
                        <p>Need a specialized sealing solution tailored to your exact specifications? Our engineering
                            team is ready to assist.</p>
                        <a href="/contact" class="btn highlight-btn">Inquire now</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="why-choose-us">
        <div class="container why-choose-split">
            <!-- Left Main Content -->
            <div class="why-choose-content">
                <span class="kicker">SERVICES</span>
                <h2 class="why-main-title">{whyChooseUsTitle}</h2>
                <p class="why-main-desc">{whyChooseUsDescription}</p>

                <h3 class="why-sub-title">This makes Reliable Industries unique:</h3>

                <div class="why-list">
                    {features.map((feature: any) => (
                        <div class="why-item">
                            <div class="why-item-header">
                                <span class="why-check-icon"></span>
                                <span class="why-item-title">{feature.title}</span>
                            </div>
                            <p class="why-item-desc">{feature.description}</p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Right Contact Card -->
            <div class="why-choose-contact">
                <div class="contact-card">
                    <div class="contact-deco-circle"></div>
                    <span class="kicker contact-kicker">CONTACT</span>
                    <h3 class="contact-title">We are happy to advise you</h3>
                    <p class="contact-desc">Would you like personal advice, do you have any questions or would you like
                        to order directly? We look forward to supporting you.</p>
                    <a href="/contact" class="btn btn-primary btn-block">Contact an expert</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Industries Section (Interactive) -->
    <section class="industries-section-new" style="background-color: var(--bg-light-grey);">
        <div class="container">
            <div class="industries-header" style="margin-bottom: 3rem;">
                <span class="kicker">INDUSTRIES</span>
                <h2 class="industries-title">Diverse solutions for numerous industries</h2>
                <p class="industries-intro">Every industry has its special requirements. Reliable Industries is an internationally leading system provider of sealing technology. Our products and solutions are used successfully around the world.</p>
            </div>

            <div class="industries-split-new">
                <div class="industry-image-left">
                    <div class="industry-image-track" id="ind-image-track">
                        <!-- Images populated by JS -->
                    </div>
                </div>
                <div class="industry-content-right">
                    <div class="industry-text-window">
                        <div class="industry-text-track" id="ind-text-track">
                            <!-- Text items populated by JS -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Centered Navigation Below Section -->
            <div class="industry-nav-bottom-center">
                <button class="nav-btn prev" id="industry-prev-btn" aria-label="Previous Industry">&#8592;</button>
                <button class="nav-btn next" id="industry-next-btn" aria-label="Next Industry">&#8594;</button>
            </div>
        </div>
    </section>


    <!-- Engineering & Innovation Section -->
    <section class="innovation-section" style="background-color: #ffffff; padding-bottom: 0;">
        <div class="container">
            <div class="section-header carousel-header" data-aos="fade-up">
                <div>
                    <span class="kicker">INNOVATION & SUPPORT</span>
                    <h2 style="margin-bottom: 0;">Engineering & Resources</h2>
                </div>
                <div class="portfolio-controls" style="display: flex; gap: 10px;">
                    <button id="innov-prev" aria-label="Previous" style="width: 45px; height: 45px; border-radius: 50%; border: 1px solid #ddd; background: white; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: 0.3s; color: #001a3b;" onmouseover="this.style.background='#f0f0f0'" onmouseout="this.style.background='white'">&#10094;</button>
                    <button id="innov-next" aria-label="Next" style="width: 45px; height: 45px; border-radius: 50%; border: none; background: #009fe3; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; transition: 0.3s; color: white;" onmouseover="this.style.background='#007ab0'" onmouseout="this.style.background='#009fe3'">&#10095;</button>
                </div>
            </div>
            <div class="innovation-grid">
                
                <!-- Card 1 -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/mission_hero_bg.jpg" alt="Meet our experts">
                    </div>
                    <div class="innov-content">
                        <h3>Meet our experts</h3>
                        <p>We actively engineer solutions and rigorously test them in our advanced R&D facility.</p>
                        <a href="/contact" class="btn btn-cyan">Talk to an expert</a>
                    </div>
                </div>

                <!-- Card 2 -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/engineering_cad.jpg" alt="Advanced Engineering">
                    </div>
                    <div class="innov-content">
                        <h3>Advanced Engineering</h3>
                        <p>Designing reliable sealing systems for extreme and persistent problems globally.</p>
                        <a href="/contact" class="btn btn-cyan">Learn about R&D</a>
                    </div>
                </div>

                <!-- Card 3 (Completes the 6-card grid) -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/hero_industrial_new.jpg" alt="Precision Manufacturing">
                    </div>
                    <div class="innov-content">
                        <h3>Precision Manufacturing</h3>
                        <p>State-of-the-art CNC multi-axis machining and automated testing rigs guaranteeing zero-leakage.</p>
                        <a href="/contact" class="btn btn-cyan">Explore Facilities</a>
                    </div>
                </div>

                <!-- Card 4 -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/support_portal.jpg" alt="Support Portal">
                    </div>
                    <div class="innov-content">
                        <h3>Online Support</h3>
                        <p>Check product specs, access manuals, and request custom modifications.</p>
                        <a href="/contact" class="btn btn-cyan">To the Portal</a>
                    </div>
                </div>
                
                <!-- Card 5 -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/certificate_iso_1790083146225.jpg" alt="Quality Assurance" style="object-fit: contain; padding: 10px;">
                    </div>
                    <div class="innov-content">
                        <h3>Quality Assurance</h3>
                        <p>ISO 9001:2015 certified, API 682, ATEX, and FDA compliant operations.</p>
                        <a href="/contact" class="btn btn-cyan">View Certificates</a>
                    </div>
                </div>
                
                <!-- Card 6 -->
                <div class="innovation-card">
                    <div class="innov-image">
                        <img src="images/industry_energy_1790083113983.jpg" alt="Global Network">
                    </div>
                    <div class="innov-content">
                        <h3>Global Network</h3>
                        <p>Local support worldwide. Find a service center near your facilities.</p>
                        <a href="/contact" class="btn btn-cyan">Find Location</a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Product Video Section -->
    <section class="video-section" style="background-color: var(--bg-light-grey); padding: 2rem 0 3rem 0;">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: 1.5rem;">
                <span class="kicker">MEDIA</span>
                <h2 style="font-size: 2.2rem; margin-bottom: 0.5rem;">Product video: Seals</h2>
                <p>Performance under severe conditions. Watch the video now!</p>
            </div>
        </div>
        <div class="container pb-4">
            <div class="youtube-grid">
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/p3oPn7aZlSg" title="Engineering Video 1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/Ks70Q3N_kdo" title="Engineering Video 2" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/ljRpEzYK2dw" title="Engineering Video 3" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/BaEHVpKc-1Q" title="Engineering Video 4" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/p3oPn7aZlSg" title="Engineering Video 5" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div class="youtube-wrapper">
                    <iframe src="https://www.youtube.com/embed/Ks70Q3N_kdo" title="Engineering Video 6" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
            </div>

            <!-- Profile / All Videos CTA Button (PDF Page 5) -->
            <div class="video-cta-container" style="text-align: center; margin-top: 3rem;" data-aos="fade-up">
                <a href="https://www.youtube.com/@ReliableIndustries" target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="background-color: #ff0000; border-color: #ff0000; color: white; display: inline-flex; align-items: center; gap: 12px; padding: 0.95rem 2.8rem; font-size: 1.05rem; font-weight: 700; border-radius: 50px; box-shadow: 0 8px 25px rgba(255, 0, 0, 0.25); transition: all 0.3s ease;">
                    <i class="fab fa-youtube" style="font-size: 1.4rem;"></i>
                    <span>Visit Our Official Channel & Explore Videos</span>
                    <i class="fas fa-arrow-right" style="font-size: 0.9rem;"></i>
                </a>
            </div>
        </div>
    </section>

    <!-- Corporate Why Choose Us Section (PDF Page 5 Reference) -->
    <section class="corporate-why-choose">
        <div class="container">
            <div class="corporate-why-grid">
                <!-- Left Showcase Box -->
                <div class="why-showcase-box" data-aos="fade-right">
                    <div>
                        <h2 class="why-showcase-title">WHY CHOOSE US</h2>
                        <p class="why-showcase-text">
                            Adverse environmental conditions, high rotational speed and pressure levels place demanding requirements on sealing technology employed in the process industry.
                        </p>
                        <p class="why-showcase-text">
                            Reliable Industries has proven itself with its heavy-duty mechanical seals with innovative and tailor-made sealing solutions guaranteeing longer service life and optimal operational safety.
                        </p>
                    </div>
                    <a href="/contact" class="why-showcase-btn">
                        <span>Read More</span>
                        <i class="fas fa-chevron-right" style="font-size: 0.8rem;"></i>
                    </a>
                </div>

                <!-- Right 8-Pillars Grid -->
                <div class="why-pillars-grid" data-aos="fade-left">
                    <!-- Pillar 1 -->
                    <div class="why-pillar-card">
                        <span class="pillar-accent-bar" style="background-color: #f97316;"></span>
