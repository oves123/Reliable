  <script>
    document.addEventListener("DOMContentLoaded", () => {
        // Featured Products Carousel
        const featTrack = document.getElementById('feat-products-track');
        const featPrevBtn = document.getElementById('feat-prev-btn');
        const featNextBtn = document.getElementById('feat-next-btn');

        if (featTrack && featPrevBtn && featNextBtn) {
            const getFeatScrollAmount = () => {
                const firstCard = featTrack.firstElementChild as HTMLElement;
                if (firstCard) {
                    const cardWidth = firstCard.offsetWidth;
                    const gap = parseFloat(window.getComputedStyle(featTrack).gap) || 24;
                    const cardsToScroll = window.innerWidth > 992 ? 2 : 1;
                    return (cardWidth + gap) * cardsToScroll;
                }
                return 320;
            };

            featPrevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                featTrack.scrollBy({ left: -getFeatScrollAmount(), behavior: 'smooth' });
            });

            featNextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                featTrack.scrollBy({ left: getFeatScrollAmount(), behavior: 'smooth' });
            });
        }
        // Interactive Certifications Deck Rotator
        const certCards = document.querySelectorAll('.cert-doc-card');
        const certPrev = document.getElementById('cert-prev-btn');
        const certNext = document.getElementById('cert-next-btn');

        if (certCards.length > 0) {
            let activeCenterIndex = 2; // Card 2 starts in center
            const totalCards = certCards.length;

            const updateCertPositions = () => {
                certCards.forEach((card, idx) => {
                    for (let i = 0; i < 5; i++) {
                        card.classList.remove(`cert-pos-${i}`);
                    }
                    let offset = (idx - activeCenterIndex + totalCards) % totalCards;
                    let pos = (offset + 2) % totalCards;
                    card.classList.add(`cert-pos-${pos}`);
                });
            };

            if (certPrev) {
                certPrev.addEventListener('click', () => {
                    activeCenterIndex = (activeCenterIndex - 1 + totalCards) % totalCards;
                    updateCertPositions();
                });
            }

            if (certNext) {
                certNext.addEventListener('click', () => {
                    activeCenterIndex = (activeCenterIndex + 1) % totalCards;
                    updateCertPositions();
                });
            }

            certCards.forEach((card, idx) => {
                card.addEventListener('click', () => {
                    activeCenterIndex = idx;
                    updateCertPositions();
                });
            });
        }
        const setupCarousel = (gridSelector, prevId, nextId) => {
            const grid = document.querySelector(gridSelector);
            const prevBtn = document.getElementById(prevId);
            const nextBtn = document.getElementById(nextId);

            if(grid && prevBtn && nextBtn) {
                // Function to get scroll amount based on card width + gap
                const getScrollAmount = () => {
                    const firstCard = grid.firstElementChild;
                    if (firstCard) {
                        const style = window.getComputedStyle(grid);
                        const gap = parseFloat(style.getPropertyValue("gap")) || 0;
                        return firstCard.offsetWidth + gap;
                    }
                    return 300; // fallback
                };

                prevBtn.addEventListener("click", () => {
                    grid.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
                });

                nextBtn.addEventListener("click", () => {
                    grid.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
                });

                // Automatic scrolling on mobile/tablet (max-width: 1024px)
                let autoScrollInterval;
                
                const startAutoScroll = () => {
                    if (window.innerWidth <= 1024) {
                        autoScrollInterval = setInterval(() => {
                            // Check if we've reached the end
                            if (grid.scrollLeft + grid.clientWidth >= grid.scrollWidth - 10) {
                                grid.scrollTo({ left: 0, behavior: "smooth" }); // Rewind
                            } else {
                                grid.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
                            }
                        }, 3000); // 3 seconds interval
                    }
                };
                
                const stopAutoScroll = () => {
                    clearInterval(autoScrollInterval);
                };

                // Start initially
                startAutoScroll();

                // Pause on hover/touch
                grid.addEventListener("mouseenter", stopAutoScroll);
                grid.addEventListener("mouseleave", startAutoScroll);
                grid.addEventListener("touchstart", stopAutoScroll);
                grid.addEventListener("touchend", startAutoScroll);
                
                // Re-evaluate on resize
                window.addEventListener("resize", () => {
                    stopAutoScroll();
                    startAutoScroll();
                });
            }
        };

        setupCarousel(".product-grid", "portfolio-prev", "portfolio-next");
        setupCarousel(".innovation-grid", "innov-prev", "innov-next");
    });
  </script>
