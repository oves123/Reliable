---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="News & Press Releases | Reliable Industries" description="Stay updated with the latest technological developments, plant expansions, international contracts, and engineering milestones from Reliable Industries.">
  <Header />

  <!-- Hero Header -->
  <section style="background: linear-gradient(135deg, #001a3b 0%, #003B6D 100%); padding: 85px 0 100px; color: white; text-align: center;">
    <div class="container">
      <span class="kicker" style="color: #009fe3; font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px; display: block; margin-bottom: 12px;">MEDIA & ANNOUNCEMENTS</span>
      <h1 style="font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 800; margin-bottom: 20px;">News & Press Releases</h1>
      <p style="font-size: 1.15rem; color: #e2e8f0; max-width: 780px; margin: 0 auto; line-height: 1.6;">
        Discover how Reliable Industries continues to push the boundaries of mechanical sealing innovation worldwide.
      </p>
    </div>
  </section>

  <!-- News Articles Grid -->
  <section style="padding: 80px 0; background: #ffffff;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 35px;">
        
        <!-- News 1 -->
        <article style="background: #ffffff; border: 1px solid #eef2f6; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column;">
          <div style="height: 200px; background: #002b54; overflow: hidden;">
            <img src="/images/hero_industrial_new.jpg" alt="CNC Facility Expansion" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <span style="color: #009fe3; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Press Release • October 2026</span>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: #002b54; margin: 8px 0 12px 0; line-height: 1.35;">Reliable Industries Expands CNC Machining Facility to Meet Global Export Demand</h3>
              <p style="color: #64748b; font-size: 0.9rem; line-height: 1.6; margin-bottom: 18px;">
                Commissioning of new automated 5-axis DMG MORI turning centers accelerates production capacity for API 682 heavy-duty cartridge seals.
              </p>
            </div>
            <a href="/contact" style="color: #009fe3; font-weight: 700; font-size: 0.88rem; text-decoration: none;">Read Full Release &rarr;</a>
          </div>
        </article>

        <!-- News 2 -->
        <article style="background: #ffffff; border: 1px solid #eef2f6; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column;">
          <div style="height: 200px; background: #002b54; overflow: hidden;">
            <img src="/images/engineering_cad.jpg" alt="High Temp Seals" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <span style="color: #009fe3; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Technical Milestone • September 2026</span>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: #002b54; margin: 8px 0 12px 0; line-height: 1.35;">Development of Next-Gen Metal Bellows Seals for Extreme Temperature Hot Oil</h3>
              <p style="color: #64748b; font-size: 0.9rem; line-height: 1.6; margin-bottom: 18px;">
                Reliable's R&D division achieves operational qualification for high-temperature welded metal bellows seals operating up to 400°C without external cooling.
              </p>
            </div>
            <a href="/contact" style="color: #009fe3; font-weight: 700; font-size: 0.88rem; text-decoration: none;">Read Full Release &rarr;</a>
          </div>
        </article>

        <!-- News 3 -->
        <article style="background: #ffffff; border: 1px solid #eef2f6; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 18px rgba(0,0,0,0.04); display: flex; flex-direction: column;">
          <div style="height: 200px; background: #002b54; overflow: hidden;">
            <img src="/images/industry_chemical.jpg" alt="Chemical Processing" style="width: 100%; height: 100%; object-fit: cover;" />
          </div>
          <div style="padding: 25px; flex-grow: 1; display: flex; flex-direction: column; justify-content: space-between;">
            <div>
              <span style="color: #009fe3; font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Contract Win • August 2026</span>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: #002b54; margin: 8px 0 12px 0; line-height: 1.35;">Major Petrochemical Refinery Upgrades 80+ Reactor Pumps to Reliable Cartridge Systems</h3>
              <p style="color: #64748b; font-size: 0.9rem; line-height: 1.6; margin-bottom: 18px;">
                Successful plant turnaround retrofit demonstrates zero leakage in highly corrosive acidic solvent handling applications.
              </p>
            </div>
            <a href="/contact" style="color: #009fe3; font-weight: 700; font-size: 0.88rem; text-decoration: none;">Read Full Release &rarr;</a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <Footer />
</Layout>
