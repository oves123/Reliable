    <!-- Floating Contact Button -->
    <a href="#" class="floating-contact">
        <i class="fas fa-envelope"></i> <span class="text">Get a Quote</span>
    </a>

    <!-- Flyout Search Modal -->
    <div class="search-modal" id="search-modal">
        <div class="search-modal-content">
            <button class="close-search" id="close-search">&times;</button>
            <h2>What are you looking for?</h2>
            <form>
                <div class="search-input-group">
                    <input type="text" placeholder="Type to search (e.g., 'Cartridge Seal')">
                    <button type="submit"><i class="fas fa-search"></i></button>
                </div>
            </form>
        </div>
