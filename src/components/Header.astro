          }
        ]
      }
    ]
  }
];

// Helper to clean product names in dropdown (remove Inside/Outside and append series number to differentiate)
function getDropdownProductName(prod: any) {
  let name = prod.name || '';
  name = name.replace(/\b(Inside|Outside)\s*(Mounting|Mounted)?\b\s*/gi, '');
  const numMatch = (prod.slug || '').match(/-(\d+)$/);
  if (numMatch && !name.match(new RegExp('\\b' + numMatch[1] + '\\b'))) {
    if (/Series$/i.test(name.trim())) {
      name = name.trim() + ' ' + numMatch[1];
    }
  }
  return name.replace(/\s+/g, ' ').trim();
}

function getProductSpecs(prod: any) {
  const specs: { label: string; value: string }[] = [];
  const raw = prod.specs || {};

  const rawSize = raw.Size || prod.Size || raw['Rotary joint size available'] || prod.rotary_joint_size_available;
  if (rawSize) {
    const cleanedSize = String(rawSize)
      .replace(/--/g, ' - ')
      .replace(/- -/g, ' - ')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Size', value: cleanedSize });
  }

  const rawTemp = raw.Temp || prod.Temp || raw['Temperature range'] || prod.temperature_range;
  if (rawTemp) {
    const cleanedTemp = String(rawTemp)
      .replace(/\bTO\b/gi, 'to')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Temp', value: cleanedTemp });
  }

  if (specs.length < 2) {
    const rawPress = raw.Press || prod.Press || raw.Prees || prod.Prees || raw.Pressure || prod.pressure;
    if (rawPress) {
      specs.push({ label: 'Press', value: String(rawPress).trim() });
    }
  }

  if (specs.length === 0 && (raw.Capacity || prod.Capacity)) {
    specs.push({ label: 'Cap', value: String(raw.Capacity || prod.Capacity).trim() });
  }

  return specs;
}
