import { sanityClient } from 'sanity:client';
import groq from 'groq';
import productsData from '../data/products.json';

// Filter out 'Special Seal', 'Dairy Used' products, the 4th cartridge seal (series-50), and duplicate hydraulic rotary union (id 32) from dropdown
const dropdownProducts = productsData.filter(p => 
  p.name !== 'Special Seal' && 
  !p.slug.includes('special-seal') &&
  !p.name.includes('Dairy Used') &&
  p.categorySlug !== 'dairy-seal' &&
  p.slug !== 'reliable-cartridge-seal-series-50' &&
  p.slug !== 'rdf-h-200-this-is-hydraulic-rotating-union-32' &&
  p.id !== 32
);

const navData = await sanityClient.fetch(groq`*[_type == "navigation"][0]`);
const menuItems = navData?.menuItems || [];

// 3-Tier Hierarchy: Super Categories -> Sub Categories -> Products
const superCategories = [
  {
    id: 'mechanical-seal',
    title: 'Mechanical Seal',
    icon: 'fa-cog',
    subcategories: [
      {
        id: 'multi-spring',
        title: 'Multi Spring Seal',
        slug: 'multi-spring-series-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'multi-spring-series-seal' || p.categorySlug === 'mechanical-seal').slice(0, 9)
      },
      {
        id: 'single-spring',
        title: 'Single Spring Seal',
        slug: 'single-spring-series-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'single-spring-series-seal').slice(0, 9)
      },
      {
        id: 'rubber-bellow',
        title: 'Rubber Bellow Seal',
        slug: 'water-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'water-seal').slice(0, 9)
      },
      {
        id: 'high-temp',
        title: 'High Temperature Seal',
        slug: 'high-temp-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'high-temp-seal').slice(0, 9)
      },
      {
        id: 'cartridge',
        title: 'Cartridge Seal',
        slug: 'cartridge-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'cartridge-seal').slice(0, 9)
      },
      {
        id: 'reactor-seal',
        title: 'Reactor Seal',
        slug: 'reactor-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'reactor-seal').slice(0, 9)
      },
      {
        id: 'agitator-seal',
        title: 'Agitator Seal',
        slug: 'agitator-seal',
        products: dropdownProducts.filter(p => p.categorySlug === 'agitator-seal').slice(0, 9)
      }
    ]
  },
  {
    id: 'rotary-joints',
    title: 'Rotary Joints',
    icon: 'fa-sync-alt',
    subcategories: [
      {
        id: 'water-rotary',
        title: 'Water Rotary Joints',
        slug: 'water-rotary-joints',
        products: dropdownProducts.filter(p => p.categorySlug === 'water-rotary-joints').slice(0, 9)
      },
      {
