    <!-- Elite UX: Preloader -->
    <div id="preloader">
        <div class="loader-spinner"></div>
    </div>

    <!-- Elite UX: Scroll Progress -->
    <div id="scroll-progress"></div>

    <!-- Certification Marquee -->
    <div class="cert-marquee">
        <div class="cert-marquee-content">
            <span><i class="fas fa-certificate"></i> API SPEC Q1</span>
            <span><i class="fas fa-certificate"></i> ISO 9001:2015</span>
            <span><i class="fas fa-certificate"></i> ATEX 2014/34/EU</span>
            <span><i class="fas fa-certificate"></i> FDA Compliant</span>
            <span><i class="fas fa-certificate"></i> ASME U Stamp</span>
            <span><i class="fas fa-certificate"></i> ISO 14001:2015</span>
            <!-- Duplicate for infinite scroll effect -->
            <span><i class="fas fa-certificate"></i> API SPEC Q1</span>
            <span><i class="fas fa-certificate"></i> ISO 9001:2015</span>
            <span><i class="fas fa-certificate"></i> ATEX 2014/34/EU</span>
            <span><i class="fas fa-certificate"></i> FDA Compliant</span>
            <span><i class="fas fa-certificate"></i> ASME U Stamp</span>
            <span><i class="fas fa-certificate"></i> ISO 14001:2015</span>
        </div>
    </div>

    <!-- Utility Bar -->
    <div class="utility-bar">
        <div class="container utility-content">
            <div class="utility-left">
                <span>Reliable Industries Group</span>
            </div>
            <div class="utility-right">
                <a href="#">Download Center</a>
                <a href="#">Contact</a>
                <a href="#">myReliable Portal ↗</a>
                <a href="#">Language: EN</a>
            </div>
        </div>
    </div>

