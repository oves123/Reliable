    <script is:inline>
    function switchSuperCat(superId, el, e) {
        if (e && window.innerWidth <= 992 && e.type === 'click') {
            e.preventDefault();
        }
        document.querySelectorAll('.super-cat-btn').forEach(b => b.classList.remove('active'));
        if (el) el.classList.add('active');

        document.querySelectorAll('.sub-col-group').forEach(g => g.style.display = 'none');
        const targetSubCol = document.getElementById('subcol-' + superId);
        if (targetSubCol) {
            targetSubCol.style.display = 'block';
            const firstSubBtn = targetSubCol.querySelector('.sub-cat-btn');
            if (firstSubBtn) {
                const subId = firstSubBtn.getAttribute('data-sub-id');
                switchSubCat(superId, subId, firstSubBtn, null);
            }
        }
    }

    function switchSubCat(superId, subId, el, e) {
        if (e && window.innerWidth <= 992 && e.type === 'click') {
            e.preventDefault();
        }
        const parentGroup = el ? el.closest('.sub-col-group') : document.getElementById('subcol-' + superId);
        if (parentGroup) {
            parentGroup.querySelectorAll('.sub-cat-btn').forEach(b => b.classList.remove('active'));
        }
        if (el) el.classList.add('active');

        document.querySelectorAll('.sub-products-panel').forEach(p => p.style.display = 'none');
        const targetPanel = document.getElementById('panel-' + superId + '-' + subId);
        if (targetPanel) {
            targetPanel.style.display = 'flex';
        }
    }

    // Mobile nested 3-tier accordion event handlers
    document.addEventListener('DOMContentLoaded', () => {
        // Level 1: Super categories toggle
        const superHeaders = document.querySelectorAll('.mobile-super-header');
        superHeaders.forEach(header => {
            header.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const item = header.closest('.mobile-super-item');
                if (!item) return;
                const isOpen = item.classList.contains('open');

                // Collapse other super items
                document.querySelectorAll('.mobile-super-item.open').forEach(other => {
                    if (other !== item) {
                        other.classList.remove('open');
                        const btn = other.querySelector('.mobile-super-header');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    }
                });

                if (isOpen) {
                    item.classList.remove('open');
                    header.setAttribute('aria-expanded', 'false');
                } else {
                    item.classList.add('open');
                    header.setAttribute('aria-expanded', 'true');
                }
            });
        });

        // Level 2: Sub categories toggle
        const subHeaders = document.querySelectorAll('.mobile-sub-header');
        subHeaders.forEach(header => {
            header.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const item = header.closest('.mobile-sub-item');
                if (!item) return;
                const isOpen = item.classList.contains('open');

                // Collapse other sub-items inside same parent super item
                const parentSuper = item.closest('.mobile-super-item');
                if (parentSuper) {
                    parentSuper.querySelectorAll('.mobile-sub-item.open').forEach(other => {
                        if (other !== item) {
                            other.classList.remove('open');
                            const btn = other.querySelector('.mobile-sub-header');
                            if (btn) btn.setAttribute('aria-expanded', 'false');
                        }
                    });
                }

                if (isOpen) {
                    item.classList.remove('open');
                    header.setAttribute('aria-expanded', 'false');
                } else {
                    item.classList.add('open');
                    header.setAttribute('aria-expanded', 'true');
                }
            });
        });
    });
    </script>

