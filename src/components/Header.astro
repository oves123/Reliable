---
import { sanityClient } from 'sanity:client';
import groq from 'groq';
import productsData from '../data/products.json';

const navData = await sanityClient.fetch(groq`*[_type == "navigation"][0]`);
const menuItems = navData?.menuItems || [];

// Group products for the detailed Sealmatic-style mega menu
const productGroups = [
  {
    id: 'cartridge',
    title: 'Standard Cartridge Seals',
    slug: 'cartridge-seal',
    products: productsData.filter(p => p.categorySlug === 'cartridge-seal').slice(0, 9)
  },
  {
    id: 'single-spring',
    title: 'Single Spring Series Seals',
    slug: 'single-spring-series-seal',
    products: productsData.filter(p => p.categorySlug === 'single-spring-series-seal').slice(0, 9)
  },
  {
    id: 'multi-spring',
    title: 'Multi Spring Series Seals',
    slug: 'multi-spring-series-seal',
    products: productsData.filter(p => p.categorySlug === 'multi-spring-series-seal').slice(0, 9)
  },
  {
    id: 'water-rotary',
    title: 'Water Rotary Joints',
    slug: 'water-rotary-joints',
    products: productsData.filter(p => p.categorySlug === 'water-rotary-joints').slice(0, 9)
  },
  {
    id: 'hot-oil-rotary',
    title: 'Hot Oil & Steam Rotary Joints',
    slug: 'hot-oil-rotary-joints',
    products: productsData.filter(p => p.categorySlug === 'hot-oil-rotary-joints' || p.categorySlug === 'steam-rotary-joints').slice(0, 9)
  },
  {
    id: 'hydraulic-rotary',
    title: 'Hydraulic Rotary Joints',
    slug: 'hydrolic-rotary-joints',
    products: productsData.filter(p => p.categorySlug === 'hydrolic-rotary-joints').slice(0, 9)
  },
  {
    id: 'reactor-agitator',
    title: 'Reactor & Agitator Seals',
    slug: 'reactor-seal',
    products: productsData.filter(p => p.categorySlug === 'reactor-seal' || p.categorySlug === 'agitator-seal').slice(0, 9)
  },
  {
    id: 'high-temp',
    title: 'High Temp Seals',
    slug: 'high-temp-seal',
    products: productsData.filter(p => p.categorySlug === 'high-temp-seal').slice(0, 9)
  },
  {
    id: 'support-systems',
    title: 'Supply Systems & Heat Exchangers',
    slug: 'thermosyphon',
    products: productsData.filter(p => p.categorySlug === 'thermosyphon' || p.categorySlug === 'heat-exchanged-system').slice(0, 9)
  },
  {
    id: 'dairy-water',
    title: 'Dairy & Water Bellow Seals',
    slug: 'water-seal',
    products: productsData.filter(p => p.categorySlug === 'water-seal' || p.categorySlug === 'dairy-seal').slice(0, 9)
  }
];

// Helper to extract cleanly formatted specs for mega-menu cards
function getProductSpecs(prod: any) {
  const specs: { label: string; value: string }[] = [];
  const raw = prod.specs || {};

  const rawSize = raw.Size || prod.Size;
  if (rawSize) {
    const cleanedSize = String(rawSize)
      .replace(/--/g, ' - ')
      .replace(/- -/g, ' - ')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Size', value: cleanedSize });
  }

  const rawTemp = raw.Temp || prod.Temp;
  if (rawTemp) {
    const cleanedTemp = String(rawTemp)
      .replace(/\bTO\b/gi, 'to')
      .replace(/\s+/g, ' ')
      .trim();
    specs.push({ label: 'Temp', value: cleanedTemp });
  }

  if (specs.length < 2) {
    const rawPress = raw.Press || prod.Press || raw.Prees || prod.Prees;
    if (rawPress) {
      specs.push({ label: 'Press', value: String(rawPress).trim() });
    }
  }

  if (specs.length === 0 && (raw.Capacity || prod.Capacity)) {
    specs.push({ label: 'Cap', value: String(raw.Capacity || prod.Capacity).trim() });
  }

  return specs;
}
