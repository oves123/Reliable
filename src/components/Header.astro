---
import { sanityClient } from 'sanity:client';
import groq from 'groq';

const navData = await sanityClient.fetch(groq`*[_type == "navigation"][0]`);
const menuItems = navData?.menuItems || [];
---
    <!-- Elite UX: Preloader -->
    <div id="preloader">
        <div class="loader-spinner"></div>
    </div>

    <!-- Elite UX: Scroll Progress -->
    <div id="scroll-progress"></div>

    <!-- Certification Marquee -->
    <div class="cert-marquee">
        <div class="cert-marquee-content">
            <span><i class="fas fa-certificate"></i> API SPEC Q1</span>
            <span><i class="fas fa-certificate"></i> ISO 9001:2015</span>
            <span><i class="fas fa-certificate"></i> ATEX 2014/34/EU</span>
            <span><i class="fas fa-certificate"></i> FDA Compliant</span>
            <span><i class="fas fa-certificate"></i> ASME U Stamp</span>
            <span><i class="fas fa-certificate"></i> ISO 14001:2015</span>
            <!-- Duplicate for infinite scroll effect -->
            <span><i class="fas fa-certificate"></i> API SPEC Q1</span>
            <span><i class="fas fa-certificate"></i> ISO 9001:2015</span>
            <span><i class="fas fa-certificate"></i> ATEX 2014/34/EU</span>
            <span><i class="fas fa-certificate"></i> FDA Compliant</span>
            <span><i class="fas fa-certificate"></i> ASME U Stamp</span>
            <span><i class="fas fa-certificate"></i> ISO 14001:2015</span>
        </div>
    </div>

    <!-- Utility Bar -->
    <div class="utility-bar">
        <div class="container utility-content">
            <div class="utility-left">
                <span>Reliable Industries Group</span>
            </div>
            <div class="utility-right">
                <a href="#">Download Center</a>
                <a href="/contact">Contact</a>
                <a href="#">myReliable Portal ↗</a>
                <a href="#">Language: EN</a>
            </div>
        </div>
    </div>

    <!-- Main Header -->
    <header class="main-header">
        <div class="container header-content">
            <a href="/" class="logo">
                <div class="logo-text">
                    <div style="display: flex; gap: 6px; align-items: baseline;">
                        <h1>Reliable</h1>
                        <h2>Industries</h2>
                    </div>
                    <span class="tagline">PIONEER IN SEALING</span>
                </div>
            </a>
            <button class="mobile-menu-toggle" aria-label="Toggle navigation">
                <span class="hamburger"></span>
            </button>
            <nav class="main-nav">
                <ul>
                                        {menuItems.map((item: any) => (
                        <li class="has-mega-menu">
                            <a href={item.link} class={item.title === 'Products' ? 'active' : ''}>{item.title} <i class="fas fa-chevron-down" style="font-size: 0.75rem;"></i></a>
                            <div class="mega-menu">
                                <div class="mega-menu-grid" style={item.promo ? '' : 'grid-template-columns: 1fr;'}>
                                    {item.promo && (
                                        <div class="mega-menu-featured" style="background: linear-gradient(135deg, rgba(0, 159, 227, 0.1), rgba(0, 0, 0, 0.05)); border: 1px solid rgba(0, 0, 0, 0.1);">
                                            <h3>{item.promo.title}</h3>
                                            <p>{item.promo.description}</p>
                                            <a href={item.promo.buttonUrl} class="btn-small" style="background: var(--color-primary-navy);">{item.promo.buttonText}</a>
                                        </div>
                                    )}
                                    <div class="mega-menu-columns" style={item.promo ? '' : 'gap: 3rem;'}>
                                        {item.columns?.map((col: any) => (
                                            <div>
                                                <h4>{col.columnTitle}</h4>
                                                <ul>
                                                    {col.links?.map((link: any) => (
                                                        <li><a href={link.url}>{link.title}</a></li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </li>
                    ))}
                    <li>
                        <button class="search-trigger" id="search-trigger">
                            <i class="fas fa-search"></i>
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Floating Contact Button -->
    <a href="/contact" class="floating-contact">
        <i class="fas fa-envelope"></i> <span class="text">Get a Quote</span>
    </a>

    <!-- Flyout Search Modal -->
    <div class="search-modal" id="search-modal">
        <div class="search-modal-content">
            <button class="close-search" id="close-search">&times;</button>
            <h2>What are you looking for?</h2>
            <form id="search-form" autocomplete="off" onsubmit="handleSearchSubmit(event)">
                <div class="search-input-group" style="position: relative;">
                    <input type="text" id="search-input" placeholder="Type to search (e.g., 'Cartridge Seal')" oninput="handleSearchInput(this.value)" onkeydown="handleSearchKeydown(event)">
                    <button type="submit"><i class="fas fa-search"></i></button>
                </div>
                <div id="search-suggestions" style="display:none; position:absolute; background:white; border:1px solid #e0e0e0; border-radius:0 0 8px 8px; max-height:320px; overflow-y:auto; width:100%; z-index:999; box-shadow: 0 8px 20px rgba(0,0,0,0.1);"></div>
            </form>
            <p id="search-no-results" style="display:none; color:#666; margin-top:1rem; font-size:0.95rem;">No products found. Try a different keyword.</p>
        </div>
    </div>

