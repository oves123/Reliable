        {"id":50,"name":"Reliable Cartridge seal Series","category":"Cartridge Seal","slug":"reliable-cartridge-seal-series-50","categorySlug":"cartridge-seal"}
    ];

    let selectedIndex = -1;
    let filteredResults = [];

    function handleSearchInput(query) {
        const q = query.trim().toLowerCase();
        const box = document.getElementById('search-suggestions');
        const noResults = document.getElementById('search-no-results');
        selectedIndex = -1;

        if (q.length < 2) {
            box.style.display = 'none';
            noResults.style.display = 'none';
            return;
        }

        filteredResults = ALL_PRODUCTS.filter(p =>
            p.name.toLowerCase().includes(q) ||
            p.category.toLowerCase().includes(q)
        );

        if (filteredResults.length === 0) {
            box.style.display = 'none';
            noResults.style.display = 'block';
            return;
        }

        noResults.style.display = 'none';
        box.innerHTML = filteredResults.slice(0, 10).map((p, i) => `
            <a href="/products/${p.categorySlug}/${p.slug}"
               data-index="${i}"
               style="display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid #f0f0f0; text-decoration:none; color:#333; transition:background 0.2s;"
               onmouseover="this.style.background='#f0f8ff'"
               onmouseout="this.style.background='white'">
                <i class="fas fa-cog" style="color:#009fe3; font-size:0.85rem; flex-shrink:0;"></i>
                <div>
                    <div style="font-weight:600; font-size:0.9rem; color:#001a3b;">${p.name}</div>
                    <div style="font-size:0.78rem; color:#888;">${p.category}</div>
                </div>
            </a>
        `).join('');
        box.style.display = 'block';
    }

    function handleSearchKeydown(e) {
        const box = document.getElementById('search-suggestions');
        const items = box.querySelectorAll('a');
        if (e.key === 'ArrowDown') {
            e.preventDefault();
            selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            selectedIndex = Math.max(selectedIndex - 1, 0);
        } else if (e.key === 'Enter') {
            if (selectedIndex >= 0 && items[selectedIndex]) {
                e.preventDefault();
                window.location.href = items[selectedIndex].href;
                return;
            }
        }
        items.forEach((el, i) => {
            el.style.background = i === selectedIndex ? '#e8f4fd' : 'white';
        });
    }

    function handleSearchSubmit(e) {
        e.preventDefault();
        const q = document.getElementById('search-input').value.trim().toLowerCase();
        if (!q) return;
        const match = ALL_PRODUCTS.find(p =>
            p.name.toLowerCase().includes(q) || p.category.toLowerCase().includes(q)
        );
        if (match) {
            window.location.href = `/products/${match.categorySlug}/${match.slug}`;
        } else {
            document.getElementById('search-no-results').style.display = 'block';
        }
    }

    // Close suggestions when clicking outside
    document.addEventListener('click', function(e) {
        const box = document.getElementById('search-suggestions');
        if (box && !box.contains(e.target) && e.target.id !== 'search-input') {
            box.style.display = 'none';
        }
    });
    </script>
