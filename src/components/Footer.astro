                </ul>
            </div>
            <div class="footer-col">
                <h4>Industries</h4>
                <ul>
                    <li><a href="#">Oil & Gas</a></li>
                    <li><a href="#">Chemical Processing</a></li>
                    <li><a href="#">Pharmaceutical</a></li>
                    <li><a href="#">Power Generation</a></li>
                    <li><a href="#">Water Systems</a></li>
                    <li><a href="#">Food & Beverage</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="/about">About Us</a></li>
                    <li><a href="/management-team">Management Team</a></li>
                    <li><a href="/certifications">Certifications</a></li>
                    <li><a href="/news-press">News & Press</a></li>
                    <li><a href="/events-trade-fairs">Events & Trade Fairs</a></li>
                    <li><a href="/contact">Contact & Support</a></li>
                </ul>
                <a href="/contact" class="btn btn-primary btn-sm" style="margin-top: 20px; border-radius: 50px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Request a Quote</a>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="copyright">&copy; 2026 Reliable Industries. All rights reserved.</div>
                <div class="legal-links">
                    <a href="/privacy-policy">Privacy Policy</a>
                    <a href="/terms-conditions">Terms & Conditions</a>
                    <a href="/shipping-policy">Shipping Policy</a>
                    <a href="/disclaimer">Disclaimer</a>
