                    <p style="align-items: flex-start;"><i class="fas fa-phone-alt" style="margin-top: 4px;"></i> <span>
                        {phoneNumbers.map((phone: string, idx: number) => (
                            <Fragment key={idx}>
                                {phone}
                                {idx < phoneNumbers.length - 1 && <br />}
