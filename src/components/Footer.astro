    </footer>

    <script is:inline>
        // Simple script for header scroll effect
        window.addEventListener('scroll', () => {
            const header = document.querySelector('.main-header');
            if (window.scrollY > 40) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        // Mobile Menu & Drawer Logic
        const mobileMenuToggle = document.getElementById('mobile-menu-toggle') || document.querySelector('.mobile-menu-toggle');
        const mobileNavClose = document.getElementById('mobile-nav-close');
        const mobileNavBackdrop = document.getElementById('mobile-nav-backdrop');
        const mainNav = document.getElementById('main-nav') || document.querySelector('.main-nav');
        
        function openMobileMenu() {
            if (mobileMenuToggle) mobileMenuToggle.classList.add('active');
            if (mainNav) mainNav.classList.add('open');
            document.body.classList.add('menu-open');
        }

        function closeMobileMenu() {
            if (mobileMenuToggle) mobileMenuToggle.classList.remove('active');
            if (mainNav) mainNav.classList.remove('open');
            document.body.classList.remove('menu-open');
        }

        if (mobileMenuToggle) {
            mobileMenuToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                if (mainNav && mainNav.classList.contains('open')) {
                    closeMobileMenu();
                } else {
                    openMobileMenu();
                }
            });
        }

        if (mobileNavClose) {
            mobileNavClose.addEventListener('click', (e) => {
                e.stopPropagation();
                closeMobileMenu();
            });
        }

        if (mobileNavBackdrop) {
            mobileNavBackdrop.addEventListener('click', () => {
                closeMobileMenu();
            });
        }

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                closeMobileMenu();
            }
        });

        // Mobile Top-Level Submenu (e.g. Products) Toggle
        const megaMenuLinks = document.querySelectorAll('.has-mega-menu > a');
        megaMenuLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                if (window.innerWidth <= 992) {
                    e.preventDefault();
                    const parent = link.parentElement;
                    const willOpen = !parent.classList.contains('active-mobile-submenu');
                    
                    // Close other open submenus
                    megaMenuLinks.forEach(otherLink => {
                        if (otherLink !== link) {
                            otherLink.parentElement.classList.remove('active-mobile-submenu');
                        }
                    });

                    // Toggle current submenu
                    parent.classList.toggle('active-mobile-submenu', willOpen);
                }
            });
        });

        // Mobile Product Category Accordion Handler
        const catHeaders = document.querySelectorAll('.mobile-cat-header');
        catHeaders.forEach(header => {
            header.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const currentItem = header.closest('.mobile-cat-item');
                if (!currentItem) return;
                
                const isOpen = currentItem.classList.contains('open');

                // Collapse all other open category items for compact neatness
                document.querySelectorAll('.mobile-cat-item.open').forEach(item => {
                    if (item !== currentItem) {
                        item.classList.remove('open');
                        const otherBtn = item.querySelector('.mobile-cat-header');
                        if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                    }
                });

                // Toggle this category item
                if (isOpen) {
                    currentItem.classList.remove('open');
                    header.setAttribute('aria-expanded', 'false');
                } else {
                    currentItem.classList.add('open');
                    header.setAttribute('aria-expanded', 'true');
                }
            });
        });

        // Tab switching logic
        const tabs = document.querySelectorAll('.tab');
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                document.querySelector('.tab.active').classList.remove('active');
                tab.classList.add('active');
            });
        });

        // Hero Carousel Logic
        let currentHeroSlide = 0;
        const heroTrack = document.getElementById('hero-carousel-track');
        const heroSlides = document.querySelectorAll('.carousel-slide');
        const heroIndicators = document.querySelectorAll('.carousel-indicators .indicator');

        function updateHeroCarousel() {
            heroTrack.style.transform = `translateX(-${currentHeroSlide * 100}%)`;
            heroIndicators.forEach((ind, index) => {
                ind.classList.toggle('active', index === currentHeroSlide);
            });
        }

        function moveHeroSlide(direction) {
            currentHeroSlide = (currentHeroSlide + direction + heroSlides.length) % heroSlides.length;
            updateHeroCarousel();
        }

        function setHeroSlide(index) {
            currentHeroSlide = index;
            updateHeroCarousel();
        }

        // Auto-advance hero carousel every 5 seconds
        let heroInterval = setInterval(() => {
            moveHeroSlide(1);
        }, 5000);

        // Touch Swipe Logic for Hero Carousel
        let heroTouchStartX = 0;
        let heroTouchEndX = 0;

        heroTrack.addEventListener('touchstart', e => {
            heroTouchStartX = e.changedTouches[0].screenX;
            clearInterval(heroInterval); // Pause auto-scroll on touch
        });

        heroTrack.addEventListener('touchend', e => {
            heroTouchEndX = e.changedTouches[0].screenX;
            handleHeroSwipe();
            // Resume auto-scroll
            heroInterval = setInterval(() => {
                moveHeroSlide(1);
            }, 5000);
        });

        function handleHeroSwipe() {
            if (heroTouchEndX < heroTouchStartX - 50) {
                // Swiped Left
                moveHeroSlide(1);
            }
            if (heroTouchEndX > heroTouchStartX + 50) {
                // Swiped Right
                moveHeroSlide(-1);
            }
        }

        // Industries Interactive Section Logic (All 10 Industries from Reliable Industries Catalog)
        const industriesData = [
            {
                tag: "OIL & GAS IND.",
                title: "Oil & Gas Industry",
                desc: "Oil Refineries & Gas industries choose Reliable seals for their most difficult application for improving financial performance. Our product proved significant performance all the time.",
                image: "/images/hero_industrial_1790081823152.jpg"
            },
            {
                tag: "CHEMICAL PROCESS IND.",
                title: "Chemical Process Industry",
                desc: "The chemical processing industry's focus on environmental pollution control and significant improvement and life of their equipment. Reliable Ind. products prove high performance of sealing product and fulfill the correct requirement of this ind.",
                image: "/images/industry_chemical.jpg"
            },
            {
                tag: "PHARMACEUTICAL IND.",
                title: "Pharmaceutical Industry",
                desc: "Pharmaceutical Industries focus on cleanness environment pollution control & public health. Reliable seals for Pump & Reactor, provide high performance of equipment and solution for their critical application.",
                image: "/images/hero_pharma_light.jpg"
            },
            {
                tag: "PULP & PAPER IND.",
                title: "Pulp & Paper Industry",
                desc: "This industries focus on environment pollution control and minimize the water consumption for their equipment. Reliable Ind. prove excellent performance.",
                image: "/images/mission_hero_bg.jpg"
            },
            {
                tag: "POWER GENERATION IND.",
                title: "Power Generation Industry",
                desc: "Reliable Industries designed & developed excellent seal for nuclear, fossil or fuel plant, for handling boiler feed water fine gas & slurry etc.",
                image: "/images/industry_energy_1790083113983.jpg"
            },
            {
                tag: "MINING & MINERALS IND.",
                title: "Mining & Minerals Industry",
                desc: "This industries focus on environment control for handling slurry product or abrasive product. Reliable ind. designed & developed relevant seals to provide excellent performance.",
                image: "/images/hero_industrial_new.jpg"
            },
            {
                tag: "FOOD & BEVERAGE IND.",
                title: "Food & Beverage Industry",
                desc: "Food & Beverages Ind. focus on environment pollution control & public health and cleanness. Reliable ind. provide food grade approved seals to fulfill their commitment.",
                image: "/images/hero_pharma_light.jpg"
            },
            {
                tag: "WATER SYSTEMS",
                title: "Water Systems",
                desc: "Since the early introduction of elastomer bellow mechanical seals. Reliable has designed & developed Mech seal for residential, commercial, industrial, and agricultural water pump. As these applications become more demanding, we continue to innovate with more robust designs and improved materials to meet the need for higher pressures, corrosion, and abrasion.",
                image: "/images/hero_industrial_1790081823152.jpg"
            },
            {
                tag: "REFRIGERATION COMPRESSORS",
                title: "Refrigeration Compressors",
                desc: "Reliable pioneered the development of metal bellows seals for refrigeration compressors to meet the demand imposed by new refrigerants and strict leakage controls on ozone depleting gases. Today our seals fitted on the majority of new manufactured compressors.",
                image: "/images/engineering_cad.jpg"
            },
            {
                tag: "TEXTILE IND.",
                title: "Textile Industry",
                desc: "This industries focus on environment pollution control cleanness & public health. Reliable Ind. has designed & developed effective sealing system to prove the excellent performance & fulfill the need of this Ind.",
                image: "/images/hero_rotary_joint_product.jpg"
            }
        ];

        let currentIndIndex = 0;
        const indImageTrack = document.getElementById('ind-image-track');
        const indTextTrack = document.getElementById('ind-text-track');
        
        function initIndustriesCarousel() {
            if(!indImageTrack || !indTextTrack) return;
            indImageTrack.innerHTML = '';
            indTextTrack.innerHTML = '';

            industriesData.forEach((ind, index) => {
                // Image
                const img = document.createElement('img');
                img.src = ind.image;
                img.alt = ind.title;
                indImageTrack.appendChild(img);

                // Text
                const textItem = document.createElement('div');
                textItem.className = 'industry-text-item';
                textItem.innerHTML = `
                    <div style="font-size: 0.82rem; font-weight: 700; color: #009fe3; letter-spacing: 1.5px; margin-bottom: 0.6rem; text-transform: uppercase;">${ind.tag}</div>
                    <h3>${ind.title}</h3>
                    <p>${ind.desc}</p>
                    <a href="/contact?inquiry=${encodeURIComponent(ind.title)}" class="learn-more">Read more <span class="arrow">&#8594;</span></a>
                `;
                indTextTrack.appendChild(textItem);
            });
            updateCarouselPosition();
        }

        function updateCarouselPosition() {
            if(!indImageTrack || !indTextTrack) return;
            indImageTrack.style.transform = `translateX(-${currentIndIndex * 100}%)`;
            indTextTrack.style.transform = `translateX(-${currentIndIndex * 100}%)`;
            const counter = document.getElementById('industry-counter');
            if (counter) {
                const currentStr = String(currentIndIndex + 1).padStart(2, '0');
                const totalStr = String(industriesData.length).padStart(2, '0');
                counter.textContent = `${currentStr} / ${totalStr}`;
            }
        }

        function changeIndustry(newIndex) {
            currentIndIndex = newIndex;
            updateCarouselPosition();
        }

        const prevBtn = document.getElementById('industry-prev-btn');
        const nextBtn = document.getElementById('industry-next-btn');

        if (prevBtn) {
            prevBtn.addEventListener('click', () => {
                let newIndex = currentIndIndex - 1;
                if (newIndex < 0) newIndex = industriesData.length - 1;
                changeIndustry(newIndex);
                resetAutoSwipe();
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', () => {
                let newIndex = currentIndIndex + 1;
                if (newIndex >= industriesData.length) newIndex = 0;
                changeIndustry(newIndex);
                resetAutoSwipe();
            });
        }

        // Auto-swipe functionality (PDF Page 4)
        let autoSwipeTimer = null;
        function startAutoSwipe() {
            stopAutoSwipe();
            autoSwipeTimer = setInterval(() => {
                let newIndex = (currentIndIndex + 1) % industriesData.length;
                changeIndustry(newIndex);
            }, 4000);
        }
        function stopAutoSwipe() {
            if (autoSwipeTimer) clearInterval(autoSwipeTimer);
        }
        function resetAutoSwipe() {
            stopAutoSwipe();
            startAutoSwipe();
        }

        // Initial render & start auto-swipe
        initIndustriesCarousel();
        startAutoSwipe();

        const indSection = document.querySelector('.industries-section-new');
        if (indSection) {
            indSection.addEventListener('mouseenter', stopAutoSwipe);
            indSection.addEventListener('mouseleave', startAutoSwipe);
            indSection.addEventListener('touchstart', stopAutoSwipe);
            indSection.addEventListener('touchend', startAutoSwipe);
        }

        // Flyout Search Logic
        const searchTrigger = document.getElementById('search-trigger');
        const searchModal = document.getElementById('search-modal');
        const closeSearch = document.getElementById('close-search');

        if(searchTrigger && searchModal) {
            searchTrigger.addEventListener('click', () => {
                searchModal.classList.add('active');
            });
            closeSearch.addEventListener('click', () => {
                searchModal.classList.remove('active');
            });
        }

        // Stats Counter Animation using IntersectionObserver
        const counters = document.querySelectorAll('.stat-number');
        const observerOptions = {
            threshold: 0.5
        };
        const counterObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                const counter = entry.target;
                if (entry.isIntersecting) {
                    if (counter.classList.contains('counting')) return;
                    counter.classList.add('counting');
                    
                    const target = +counter.getAttribute('data-target');
                    const duration = 2000; 
                    const increment = target / (duration / 16); 
                    
                    let current = 0;
                    const updateCounter = () => {
                        current += increment;
                        if (current < target) {
                            counter.innerText = Math.ceil(current);
                            requestAnimationFrame(updateCounter);
                        } else {
                            counter.innerText = target;
                        }
                    };
                    updateCounter();
                } else {
                    counter.innerText = '0';
                    counter.classList.remove('counting');
                }
            });
        }, observerOptions);

        counters.forEach(counter => {
            counterObserver.observe(counter);
        });
    </script>
    <!-- AOS Animation JS -->
    <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script is:inline>
        /* ==========================================
           Elite UX Masterclass JavaScript
           ========================================== */
        
        // 1. Preloader Logic & AOS Initialization
        window.addEventListener('load', function() {
            const preloader = document.getElementById('preloader');
            if(preloader) {
                preloader.classList.add('fade-out');
                setTimeout(() => { 
                    preloader.style.display = 'none'; 
                    // Initialize AOS AFTER preloader finishes so offsets are correct
                    AOS.init({
                        duration: 800,
                        once: true,
                        offset: 100
                    });
                    AOS.refresh();
                }, 600);
            } else {
                AOS.init({
                    duration: 800,
                    once: true,
                    offset: 100
                });
            }
        });

        // 2. Scroll Progress Bar
        const scrollProgress = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            const totalScroll = document.documentElement.scrollTop;
            const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scroll = `${totalScroll / windowHeight * 100}%`;
            if(scrollProgress) {
                scrollProgress.style.width = scroll;
            }
        });

        // Custom Cursor JS Removed
    </script>
